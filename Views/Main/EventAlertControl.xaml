<UserControl x:Class="OpenCvWpfTracking.EventAlertControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="EventGridStyle" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="Background" Value="#343B42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="RowHeight" Value="27"/>
        </Style>

        <Style x:Key="EventSubTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#DDE7EC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Background" Value="#4B5259"/>
            <Setter Property="BorderBrush" Value="#91A4AF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="HeaderBorder" Height="34"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0" CornerRadius="5,5,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#355D73"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EventSubTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource EventSubTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <UniformGrid Grid.Row="0" Columns="2" IsItemsHost="True"/>
                            <Border Grid.Row="1" Background="#4B5259" BorderBrush="#91A4AF"
                                    BorderThickness="1" Padding="5">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#3B5F70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="3,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#58707D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenteredEventCellTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#40474E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinHeight" Value="27"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ACTIVE">
                    <Setter Property="Background" Value="#8B2E2E"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="CLEARED">
                    <Setter Property="Background" Value="#3F5550"/>
                    <Setter Property="Foreground" Value="#D0D7DE"/>
                </DataTrigger>
                <!-- 2026-08-26: CSV 불러오기 이후 수신된 신규 행은 밝은 청록색으로 구분한다. -->
                <DataTrigger Binding="{Binding IsLiveAfterCsvLoad}" Value="True">
                    <Setter Property="Background" Value="#176B87"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <TabControl x:Name="EventTypeTabControl"
                Margin="0" Style="{StaticResource EventSubTabControlStyle}"
                SelectedIndex="{Binding SelectedEventAlertTabIndex, Mode=TwoWay}">
        <TabItem Header="AI DETECTION">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#40464D" BorderBrush="#95A5B0"
                        BorderThickness="1.5" CornerRadius="5" Padding="8" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="AI DETECTION" Foreground="#8FD3FF"
                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AiAlertStatusText}" Foreground="{Binding AiAlertHeaderBrush}"
                                       FontSize="10" FontWeight="Bold" Margin="0,3,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ACTIVE" Foreground="#A9D6E5" FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveAiCount}" Foreground="{Binding AiAlertHeaderBrush}"
                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LAST DETECTED" Foreground="#A9D6E5" FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding LastAiEventTimeText}" Foreground="White"
                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#464D54" BorderBrush="#81909A"
                        BorderThickness="1" CornerRadius="0" Padding="0">
                    <DataGrid x:Name="AiEventGrid" ItemsSource="{Binding AiDetectionEvents}"
                              Style="{StaticResource EventGridStyle}"
                              Sorting="EventGrid_Sorting"
                              SelectionChanged="EventGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" SortMemberPath="EventId" Binding="{Binding EventId}" Width="30" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                            <DataGridTextColumn Header="TIME" SortMemberPath="DetectedTime" Binding="{Binding DetectedTimeShortText}" Width="88" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                            <DataGridTextColumn Header="CAM" SortMemberPath="Camera" Binding="{Binding Camera}" Width="42" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                            <DataGridTextColumn Header="TYPE" SortMemberPath="DetectionType" Binding="{Binding DetectionType}" Width="50" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                            <DataGridTextColumn Header="CONF" SortMemberPath="Confidence" Binding="{Binding Confidence}" Width="48" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                            <DataGridTextColumn Header="BBOX(px)" SortMemberPath="PixelArea" Binding="{Binding PixelSizeCompactText}" Width="*" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                            <DataGridTextColumn Header="STATE" SortMemberPath="Status" Binding="{Binding Status}" Width="62" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="2" Margin="0,6,0,0"
                      IsEnabled="{Binding IsEventAlertControlEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="52"/><ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AiTotalText" Grid.Column="0" Foreground="#9DD8FA"
                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="AiPreviousButton" Grid.Column="1" Content="PREVIOUS" Height="27"
                            Click="AiPreviousButton_Click"/>
                    <TextBlock x:Name="AiPageText" Grid.Column="2" Text="1 / 1" Foreground="White"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="AiNextButton" Grid.Column="3" Content="NEXT" Height="27"
                            Click="AiNextButton_Click"/>
                    <TextBlock x:Name="AiSelectedText" Grid.Column="4" Foreground="#9DD8FA"
                               FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <UniformGrid Grid.Row="3" Columns="4" Margin="0,6,0,0"
                             IsEnabled="{Binding IsEventAlertControlEnabled}">
                    <Button Content="SAVE AI CSV" Height="31" FontSize="10.5" Margin="0,0,3,0"
                            Command="{Binding SaveAiEventsCommand}"/>
                    <Button Content="LOAD AI CSV" Height="31" FontSize="10.5" Margin="2,0"
                            Command="{Binding LoadAiEventsCommand}"/>
                    <Button Content="DELETE SELECTED" Height="31" Margin="2,0"
                            Background="#705A31" Click="AiDeleteSelectedButton_Click"/>
                    <Button Content="DELETE ALL" Height="31" Margin="3,0,0,0" Background="#7A3434"
                            Command="{Binding ClearAiEventsCommand}"/>
                </UniformGrid>
            </Grid>
        </TabItem>

        <TabItem Header="FIRE DETECTION">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#40464D" BorderBrush="#95A5B0"
                        BorderThickness="1.5" CornerRadius="5" Padding="8" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FIRE DETECTION" Foreground="#FF9C92"
                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding FireAlertStatusText}"
                                       Foreground="{Binding FireAlertHeaderBrush}"
                                       FontSize="10" FontWeight="Bold" Margin="0,3,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ACTIVE" Foreground="#A9D6E5" FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveFireCount}" Foreground="#FF8A80"
                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LAST DETECTED" Foreground="#A9D6E5" FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding LastFireEventTimeText}" Foreground="White"
                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#464D54" BorderBrush="#81909A"
                        BorderThickness="1" CornerRadius="0" Padding="0">
                    <DataGrid x:Name="FireEventGrid" ItemsSource="{Binding FireDetectionEvents}"
                              Style="{StaticResource EventGridStyle}"
                              Sorting="EventGrid_Sorting"
                              SelectionChanged="EventGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" SortMemberPath="EventId" Binding="{Binding EventId}" Width="30" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                            <DataGridTextColumn Header="TIME" SortMemberPath="DetectedTime" Binding="{Binding DetectedTimeShortText}" Width="88" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                            <DataGridTextColumn Header="CAM" SortMemberPath="Camera" Binding="{Binding Camera}" Width="42" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                            <DataGridTextColumn Header="BBOX(px)" SortMemberPath="PixelArea" Binding="{Binding PixelSizeCompactText}" Width="*" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                            <DataGridTextColumn Header="AREA(px²)" SortMemberPath="PixelArea" Binding="{Binding PixelAreaDisplayText}" Width="86" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                            <DataGridTextColumn Header="STATE" SortMemberPath="Status" Binding="{Binding Status}" Width="62" ElementStyle="{StaticResource CenteredEventCellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="2" Margin="0,6,0,0"
                      IsEnabled="{Binding IsEventAlertControlEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="52"/><ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FireTotalText" Grid.Column="0" Foreground="#9DD8FA"
                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="FirePreviousButton" Grid.Column="1" Content="PREVIOUS" Height="27"
                            Click="FirePreviousButton_Click"/>
                    <TextBlock x:Name="FirePageText" Grid.Column="2" Text="1 / 1" Foreground="White"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="FireNextButton" Grid.Column="3" Content="NEXT" Height="27"
                            Click="FireNextButton_Click"/>
                    <TextBlock x:Name="FireSelectedText" Grid.Column="4" Foreground="#9DD8FA"
                               FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <UniformGrid Grid.Row="3" Columns="4" Margin="0,6,0,0"
                             IsEnabled="{Binding IsEventAlertControlEnabled}">
                    <Button Content="SAVE FIRE CSV" Height="31" FontSize="10.5" Margin="0,0,3,0"
                            Command="{Binding SaveFireEventsCommand}"/>
                    <Button Content="LOAD FIRE CSV" Height="31" FontSize="10.5" Margin="2,0"
                            Command="{Binding LoadFireEventsCommand}"/>
                    <Button Content="DELETE SELECTED" Height="31" Margin="2,0"
                            Background="#705A31" Click="FireDeleteSelectedButton_Click"/>
                    <Button Content="DELETE ALL" Height="31" Margin="3,0,0,0" Background="#7A3434"
                            Command="{Binding ClearFireEventsCommand}"/>
                </UniformGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
