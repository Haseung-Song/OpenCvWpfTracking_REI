                                                                        <Button Content="FOCUS -"
                                                                                Width="85"
                                                                                Margin="5"
                                                                                Focusable="False"
                                                                                Style="{StaticResource IrControlButtonStyle}"
                                                                                PreviewMouseDown="IrFocusFar_MouseDown"
                                                                                PreviewMouseUp="MoveStop_MouseUp"
                                                                                MouseLeave="MoveStop_MouseUp"/>

                                                                    </StackPanel>

                                                                    <!-- [IR] [Auto Focus] 제어 -->
                                                                    <Button Grid.Row="4"
                                                                            Content="AUTO FOCUS"
                                                                            Width="180"
                                                                            Margin="5"
                                                                            HorizontalAlignment="Center"
                                                                            Style="{StaticResource IrControlButtonStyle}"
                                                                            PreviewMouseDown="IrAutoFocus_MouseDown"/>

                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </TabItem>

                                                <!-- [SYNC] 환경장비 Web Agent 표준 Zoom 동기화 -->
                                                <TabItem Header="SYNC"
                                                         IsEnabled="{Binding IsOperationCommandEnabled}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <StackPanel Margin="4,4,2,6">
                                                            <!-- 환경장비 기준 EO / IR Zoom 10단계 동기화 -->
                                                            <Border Background="#2F363D"
                                                                    BorderBrush="#8A9BA8"
                                                                    BorderThickness="1"
                                                                    Padding="11">
                                                                <StackPanel>
                                                                    <TextBlock Text="EO / IR ZOOM SYNC"
                                                                               Foreground="White"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,0,0,6"/>

                                                                    <TextBlock Text="NORMALIZED POSITION : 0 ~ 1000"
                                                                               Foreground="#B9C4CC"
                                                                               FontSize="10"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,0,0,6"/>

                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="42"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="42"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <Button Grid.Column="0"
                                                                                Content="◀"
                                                                                Height="30"
                                                                                Command="{Binding PreviousZoomSyncLevelCommand}"/>

                                                                        <ComboBox Grid.Column="1"
                                                                                  Height="30"
                                                                                  Margin="5,0"
                                                                                  ItemsSource="{Binding ZoomSyncLevelOptions}"
                                                                                  SelectedItem="{Binding SelectedZoomSyncLevel}"
                                                                                  DisplayMemberPath="DisplayText"/>

                                                                        <Button Grid.Column="2"
                                                                                Content="▶"
                                                                                Height="30"
                                                                                Command="{Binding NextZoomSyncLevelCommand}"/>
                                                                    </Grid>

                                                                    <TextBlock Text="{Binding SelectedZoomSyncPositionText}"
                                                                               Foreground="#8FD3FF"
                                                                               FontSize="14"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,0,0,6"/>

                                                                    <UniformGrid Columns="2">
                                                                        <Button Content="APPLY"
                                                                                Height="32"
                                                                                Margin="2"
                                                                                Command="{Binding ApplyZoomSyncCommand}"/>
                                                                        <Button Content="STOP"
                                                                                Height="32"
                                                                                Margin="2"
                                                                                Command="{Binding StopZoomSyncCommand}"/>
                                                                    </UniformGrid>

                                                                    <TextBlock Text="{Binding ZoomSyncStatusText}"
                                                                               Foreground="#F6E05E"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,6,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- EO / IR Focus 10단계 동기화 -->
                                                            <Border Background="#2F363D"
                                                                    BorderBrush="#8A9BA8"
                                                                    BorderThickness="1"
                                                                    Padding="11"
                                                                    Margin="0,5,0,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="EO / IR FOCUS SYNC"
                                                                               Foreground="White"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,0,0,6"/>

                                                                    <TextBlock Text="WEB AGENT STANDARD : 0 ~ 1000"
                                                                               Foreground="#B9C4CC"
                                                                               FontSize="10"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,0,0,6"/>

                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="42"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="42"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <Button Grid.Column="0"
                                                                                Content="◀"
                                                                                Height="30"
                                                                                Command="{Binding PreviousFocusSyncLevelCommand}"/>

                                                                        <ComboBox Grid.Column="1"
                                                                                  Height="30"
                                                                                  Margin="5,0"
                                                                                  ItemsSource="{Binding FocusSyncLevelOptions}"
                                                                                  SelectedItem="{Binding SelectedFocusSyncLevel}"
                                                                                  DisplayMemberPath="DisplayText"/>

                                                                        <Button Grid.Column="2"
                                                                                Content="▶"
                                                                                Height="30"
                                                                                Command="{Binding NextFocusSyncLevelCommand}"/>
                                                                    </Grid>

                                                                    <TextBlock Text="{Binding SelectedFocusSyncPositionText}"
                                                                               Foreground="#8FD3FF"
                                                                               FontSize="14"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,0,0,6"/>

                                                                    <UniformGrid Columns="2">
                                                                        <Button Content="APPLY"
                                                                                Height="32"
                                                                                Margin="2"
                                                                                Command="{Binding ApplyFocusSyncCommand}"/>
                                                                        <Button Content="STOP"
                                                                                Height="32"
                                                                                Margin="2"
                                                                                Command="{Binding StopFocusSyncCommand}"/>
                                                                    </UniformGrid>

                                                                    <TextBlock Text="{Binding FocusSyncStatusText}"
                                                                               Foreground="#F6E05E"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,6,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </TabItem>

                                            </TabControl>
                                        </Grid>
                                    </TabItem>
                                </TabControl>

                                <!--
                                    HOME / PAN ZERO / TILT ZERO / AUTO SCAN 실행 상태 안내 Overlay

                                    IsEnabled Binding만 적용하면 사용자 눈에는 기존 색상과 비슷해
                                    잠금 여부가 명확하지 않을 수 있다.

                                    HOME / ZERO 중에는 기존처럼 우측 제어 전체를 잠근다.
                                    AUTO SCAN 중에는 PAN/TILT SPEED 영역에 실행 상태와
                                    전용 STOP 버튼을 표시하되, 하단 CURRENT STATUS와
                                    PRESET L / PRESET W 탭의 상태 확인은 계속 허용한다.
                                -->
                                <Border Grid.Row="1"
                                        Panel.ZIndex="100"
                                        Margin="0,8,0,8"
                                        Padding="14,12,14,16"
                                        MinHeight="142"
                                        VerticalAlignment="Center"
                                        Background="#99000000"
                                        BorderBrush="#F6E05E"
                                        BorderThickness="2"
                                        CornerRadius="5"
                                        IsHitTestVisible="True">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsControlInputLocked}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding ControlLockTitle}"
                                                   Foreground="#F6E05E"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="{Binding ControlLockMessage}"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6,0,0"/>

                                        <TextBlock Text="Control and keyboard inputs are temporarily locked."
                                                   Foreground="#D0D7DE"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"/>

                                        <Button Content="STOP AUTO SCAN"
                                                Command="{Binding StopActivePresetScanCommand}"
                                                Width="180"
                                                Height="34"
                                                Margin="0,14,0,0"
                                                Background="#8B2E2E"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                BorderBrush="#FF6B6B">

                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPresetScanControlLocked}"
                                                                     Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>

                                        </Button>

                                    </StackPanel>

                                </Border>

                            </Grid>
                        </Border>

                    </Grid>

                    <!-- [AI Detector] 설정 패널 -->
                    <Border Grid.Row="1"
                            Visibility="Collapsed"
                            Margin="5,5,5,5"
                            Background="#20262D"
                            BorderBrush="#4F6773"
                            BorderThickness="2"
                            CornerRadius="5"
                            Padding="10">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 제목 -->
                            <TextBlock Grid.Row="0"
                                       Text="AI DETECTOR SETTING"
                                       Foreground="#00B8D4"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <!-- AI Agent -->
                                    <ColumnDefinition Width="1.1*"/>
                                    <!-- RTSP Setting -->
                                    <ColumnDefinition Width="2.1*"/>
                                    <!-- Mapping Setting -->
                                    <ColumnDefinition Width="1.6*"/>
                                    <!-- Display -->
                                    <ColumnDefinition Width="1.6*"/>
                                </Grid.ColumnDefinitions>

                                <!-- [1] AI Agent 연결 설정 -->
                                <GroupBox Grid.Column="0"
                                          Header="AI Agent"
                                          Foreground="White"
                                          BorderBrush="#90A4AE"
                                          Margin="0,0,10,0">

                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="IP"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,5"/>

                                        <TextBox Grid.Row="0"
                                                 Grid.Column="1"
                                                 Height="24"
                                                 Margin="0,0,0,5"
                                                 Text="{Binding AiControlAgentIp, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="Port"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,5"/>

                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Height="24"
                                                 Margin="0,0,0,5"
                                                 Text="{Binding AiAgentPort, UpdateSourceTrigger=PropertyChanged}"/>

                                        <UniformGrid Grid.Row="2"
                                                     Grid.ColumnSpan="2"
                                                     Columns="2">

                                            <Button Content="AI CONNECT"
                                                    Margin="0,0,3,0"
                                                    Style="{StaticResource AiSettingButtonStyle}"
                                                    Background="#1F4F4A"
                                                    Command="{Binding ConnectAiAgentCommand}"/>

                                            <Button Content="AI DISCONNECT"
                                                    Margin="3,0,0,0"
                                                    Style="{StaticResource AiSettingButtonStyle}"
                                                    Background="#5A3030"
                                                    Command="{Binding DisconnectAiAgentCommand}"/>

                                        </UniformGrid>
                                    </Grid>

                                </GroupBox>

                                <!-- [2] RTSP 주소 설정 -->
                                <GroupBox Grid.Column="1"
                                          Header="RTSP Setting"
                                          Foreground="White"
                                          BorderBrush="#90A4AE"
                                          Margin="0,0,10,0">

                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="RTSP 0"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,5"/>

                                        <TextBox Grid.Row="0"
                                                 Grid.Column="1"
                                                 Height="24"
                                                 Margin="0,0,0,5"
                                                 Text="{Binding AiRtsp0Address, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="RTSP 1"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,5"/>

                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Height="24"
                                                 Margin="0,0,0,5"
                                                 Text="{Binding AiRtsp1Address, UpdateSourceTrigger=PropertyChanged}"/>

                                        <Button Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                Content="APPLY RTSP"
                                                Style="{StaticResource AiSettingButtonStyle}"
                                                Background="#263B4A"
                                                Command="{Binding ApplyAiRtspCommand}"/>
                                    </Grid>

                                </GroupBox>

                                <!-- [3] Mapping 설정 -->
                                <GroupBox Grid.Column="2"
                                          Header="Mapping Setting"
                                          Foreground="White"
                                          BorderBrush="#90A4AE"
                                          Margin="0,0,10,0">

                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="ONNX (RTSP 0)"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,5"/>

                                        <ComboBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  Height="24"
                                                  Margin="0,0,0,5"
                                                  ItemsSource="{Binding AiOnnxList}"
                                                  SelectedValue="{Binding AiRtsp0OnnxIndex, Mode=TwoWay}"
                                                  SelectedValuePath="Index"
                                                  DisplayMemberPath="FileName"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="ONNX (RTSP 1)"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,5"/>

                                        <ComboBox Grid.Row="1"
                                                  Grid.Column="1"
                                                  Height="24"
                                                  Margin="0,0,0,5"
                                                  ItemsSource="{Binding AiOnnxList}"
                                                  SelectedValue="{Binding AiRtsp1OnnxIndex, Mode=TwoWay}"
                                                  SelectedValuePath="Index"
                                                  DisplayMemberPath="FileName"/>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="Confidence"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,5"/>

                                        <Slider Grid.Row="2"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="1"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                Value="{Binding AiMappingConfidence, Mode=TwoWay}"
                                                Margin="0,0,10,5"/>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="2"
                                                   Text="{Binding AiMappingConfidenceText}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Text="IOU"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,5"/>

                                        <Slider Grid.Row="3"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="1"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                Value="{Binding AiMappingIou, Mode=TwoWay}"
                                                Margin="0,0,10,5"/>

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="2"
                                                   Text="{Binding AiMappingIouText}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,5"/>

                                        <Button Grid.Row="4"
                                                Grid.ColumnSpan="2"
                                                Content="APPLY MAPPING"
                                                Style="{StaticResource AiSettingButtonStyle}"
                                                Background="#34505F"
                                                Command="{Binding ApplyAiMappingCommand}"/>
                                    </Grid>

                                </GroupBox>

                                <!-- [4] 표시 / 조회 설정 -->
                                <GroupBox Grid.Column="3"
                                          Header="Display / Query"
                                          Foreground="White"
                                          BorderBrush="#90A4AE">

                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Box Filter"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,5"/>

                                        <Slider Grid.Row="0"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="1"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                Value="{Binding AiDisplayConfidenceThreshold, Mode=TwoWay}"
                                                Margin="0,0,10,5"/>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="2"
                                                   Text="{Binding AiDisplayConfidenceThresholdText}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,5"/>

                                        <CheckBox Grid.Row="1"
                                                  Grid.ColumnSpan="2"
                                                  Content="AUTO TRACKING"
                                                  Foreground="#00E676"
                                                  FontWeight="Bold"
                                                  IsChecked="{Binding IsAutoTrackingEnabled}"
                                                  Margin="0,5,0,5"/>

                                        <Button Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                Content="REFRESH AI INFO"
                                                Style="{StaticResource AiSettingButtonStyle}"
                                                Background="#3A4058"
                                                Command="{Binding RefreshAiSettingCommand}"/>

                                        <TextBlock Grid.Row="3"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding AiSettingStatusText}"
                                                   Foreground="#00E676"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,6"/>

                                        <TabControl Grid.Row="4"
                                                    Grid.ColumnSpan="3"
                                                    FontSize="11">

                                            <TabItem Header="RTSP">
                                                <ListBox ItemsSource="{Binding AiRtspList}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock TextWrapping="Wrap">
                                                                <Run Text="{Binding Index}"/>
                                                                <Run Text=" : "/>
                                                                <Run Text="{Binding Url}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </TabItem>

                                            <TabItem Header="ONNX">
                                                <ListBox ItemsSource="{Binding AiOnnxList}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock FontWeight="Bold">
                                                                    <Run Text="{Binding Index}"/>
                                                                    <Run Text=" : "/>
                                                                    <Run Text="{Binding FileName}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </TabItem>

                                            <TabItem Header="MAP">
                                                <ListBox ItemsSource="{Binding AiMappingList}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <Run Text="RTSP "/>
                                                                <Run Text="{Binding RtspIndex}"/>
                                                                <Run Text=" → ONNX "/>
                                                                <Run Text="{Binding OnnxIndex}"/>
                                                                <Run Text=" / C "/>
                                                                <Run Text="{Binding Confidence}"/>
                                                                <Run Text=" / I "/>
                                                                <Run Text="{Binding Iou}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </TabItem>

                                            <!--
                                                [이동 제어] Tab

                                                VertiportNexus의 이동 제어 UI / 계산 방식을
                                                현재 EO / IR 통합 장비 구조에 맞춰 적용한다.

                                                포함 기능:
                                                1) PAN TURN MODE
                                                2) PAN / TILT Absolute
                                                3) EO / IR Zoom Position
                                                4) EO / IR Zoom Ratio
                                                5) EO / IR Focus Position
                                                6) 입력값 초기화

                                                추가 기능:
                                                1) HOME POSITION
                                                2) PAN ZERO
                                                3) TILT ZERO
                                            -->

                                        </TabControl>

                                    </Grid>

                                </GroupBox>

                            </Grid>
                        </Grid>

                    </Border>

                </Grid>
            </Viewbox>

        </Grid>
    </Border>

</Window>
