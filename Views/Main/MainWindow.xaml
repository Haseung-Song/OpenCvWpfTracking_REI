<Window x:Class="OpenCvWpfTracking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenCvWpfTracking"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="[REI] EO/IR VIDEO MONITORING &amp; PTZF CONTROL VIEWER"
        Width="1920"
        Height="1080"
        MinWidth="960"
        MinHeight="540"
        Background="#2C313A"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderThickness="0"
        BorderBrush="Transparent"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Deactivated="Window_Deactivated"
        PreviewMouseLeftButtonDown="WindowFrame_PreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="WindowFrame_PreviewMouseLeftButtonUp"
        PreviewMouseMove="WindowFrame_PreviewMouseMove"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <!--
        [DEMO UI] 사용자 정의 Window Frame

        기본 Title Bar를 숨긴 상태에서도 창 가장자리와 네 모서리에서
        마우스로 크기를 조절할 수 있도록 WindowChrome을 적용한다.

        외곽 모서리와 내부 Title Bar의 반경을 동일하게 사용하여
        서로 다른 배경색이 모서리 밖으로 돌출되어 보이지 않게 한다.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="8"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- [EO / IR] 영상 중앙 십자선 공통 Template

            화면 전체를 가로지르는 기준선이 아니라
            실제 운용 시 영상과 AI Bounding Box를 가리지 않도록
            중앙에 짧게 표시하는 십자가 형태로 구성한다.

            수평선과 수직선이 화면 중심에서 교차하며,
            검정 외곽선 위에 선택된 색상의 본선을 겹쳐 표시하여
        밝은 EO 영상과 흑백 IR 영상에서 모두 식별 가능하도록 한다. -->
        <ControlTemplate x:Key="CenterCrosshairTemplate"
                         TargetType="Control">
            <Grid Width="72"
                  Height="72"
                  IsHitTestVisible="False">

                <!-- 검정 외곽선 -->
                <Canvas Width="72"
                        Height="72">
                    <Line X1="36"
                          Y1="2"
                          X2="36"
                          Y2="70"
                          Stroke="#CC000000"
                          StrokeThickness="4"/>
                    <Line X1="2"
                          Y1="36"
                          X2="70"
                          Y2="36"
                          Stroke="#CC000000"
                          StrokeThickness="4"/>
                </Canvas>

                <!-- 사용자 선택 순환 색상의 십자선 본선 -->
                <Canvas Width="72"
                        Height="72">
                    <Line X1="36"
                          Y1="2"
                          X2="36"
                          Y2="70"
                          Stroke="{Binding CrosshairBrush}"
                          StrokeThickness="2"/>
                    <Line X1="2"
                          Y1="36"
                          X2="70"
                          Y2="36"
                          Stroke="{Binding CrosshairBrush}"
                          StrokeThickness="2"/>
                </Canvas>

            </Grid>
        </ControlTemplate>

        <!-- [AI Detector] 설정 패널 공통 버튼 스타일 -->
        <Style x:Key="AiSettingButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Margin"
                    Value="0,5,0,0"/>
        </Style>

        <!-- [장비 제어] 일반 버튼 스타일 -->
        <Style x:Key="DeviceControlButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Height"
                    Value="30"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Opacity"
                            Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- [장비 연결] 버튼 스타일 -->
        <Style x:Key="ConnectButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#2F4F5F"/>
        </Style>

        <!-- [연결 해제] 버튼 스타일 -->
        <Style x:Key="DisconnectButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#4A2F2F"/>
        </Style>

        <!-- [PAN/TILT] 방향 버튼 스타일 -->
        <Style x:Key="PanTiltDirectionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#37474F"/>
            <Setter Property="Margin"
                    Value="4"/>
            <Setter Property="Width"
                    Value="32"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="FontSize"
                    Value="18"/>
        </Style>

        <!-- [STOP] 버튼 스타일 -->
        <Style x:Key="StopButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#7A2525"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="BorderBrush"
                    Value="#708090"/>
            <Setter Property="FontSize"
                    Value="10"/>
        </Style>

        <!-- [EO] 제어 버튼 스타일 -->
        <Style x:Key="EoControlButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#30475A"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>

        <!-- [EO] Focus RepeatButton 스타일 -->
        <Style x:Key="EoFocusRepeatButtonStyle"
               TargetType="RepeatButton">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Background"
                    Value="#30475A"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="FontSize"
                    Value="12"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Opacity"
                            Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- [IR] 제어 버튼 스타일 -->
        <Style x:Key="IrControlButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#4A405F"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>

        <!-- [LRF] 제어 버튼 스타일 -->
        <Style x:Key="LrfControlButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#35514F"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>

        <!-- [우측 제어 패널] Tab Header 스타일 -->
        <Style x:Key="RightPanelTabItemStyle"
               TargetType="TabItem">

            <Setter Property="Foreground"
                    Value="#D0D7DE"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <!-- 탭 사이 간격 -->
            <Setter Property="Margin"
                    Value="0,0,1,0"/>

            <!-- 탭이 남는 공간을 균등하게 사용하도록 설정 -->
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TabItem">

                        <Border x:Name="TabBorder"
                                Width="78"
                                Height="32"
                                Background="#4F5860"
                                BorderBrush="#95A5B0"
                                BorderThickness="1,1,1,0"
                                CornerRadius="5,5,0,0"
                                Padding="8,8">

                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#5F666D"/>

                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="#AAB4BE"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#3B5F70"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- [상단 우측 패널] 통신 설정 / 운용 제어 전용 50:50 Tab Header 스타일 -->
        <Style x:Key="TopRightPanelTabItemStyle"
               TargetType="TabItem">

            <Setter Property="Foreground"
                    Value="#D0D7DE"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Margin"
                    Value="0,0,1,0"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TabItem">

                        <Border x:Name="TabBorder"
                                HorizontalAlignment="Stretch"
                                Height="33"
                                Background="#4F5860"
                                BorderBrush="#95A5B0"
                                BorderThickness="1,1,1,0"
                                CornerRadius="5,5,0,0"
                                Padding="8,8">

                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#5F666D"/>

                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="#AAB4BE"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#3B5F70"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!--
            상단 통신 설정 / 운용 제어 전용 TabControl Template

            기본 WPF TabControl은 Header 영역에 TabPanel을 사용하므로
            ItemsPanel을 UniformGrid로 지정해도 Header가 내용 크기만큼만 표시될 수 있다.

            상단 TabControl만 전용 Template을 사용하여 Header Host 자체를 UniformGrid 2열로 구성한다.
        -->
        <Style x:Key="TopRightPanelTabControlStyle"
               TargetType="TabControl">

            <!-- HOME POSITION Lock 시 실제 입력 차단 상태가 눈에 보이도록 흐리게 표시 -->
            <Setter Property="Opacity"
                    Value="1"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TabControl">

                        <Grid KeyboardNavigation.TabNavigation="Local">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 상단 탭 Header를 전체 너비 기준 정확히 50:50 배치 -->
                            <UniformGrid Grid.Row="0"
                                         Rows="1"
                                         Columns="2"
                                         IsItemsHost="True"
                                         HorizontalAlignment="Stretch"
                                         KeyboardNavigation.TabIndex="1"/>

                            <!-- 선택된 탭 내용 -->
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">

                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                            </Border>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

            <!--
                WPF Style의 속성 요소는 Setter들 사이에 들어갈 수 없으므로
                모든 Setter 선언 뒤에 Triggers를 배치한다.
            -->
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.42"/>
                </Trigger>
            </Style.Triggers>

        </Style>

        <!-- [통신 설정] CONTROL / RTSP 및 AI DETECTOR 하위 탭 전용 스타일

            상위 탭의 둥근 모서리 Template을 중첩해 사용하지 않고,
            직선형 Header와 하나의 Content Border만 사용한다.
        중첩 Border의 색상 단차와 양쪽 모서리 돌출을 방지한다. -->
        <Style x:Key="CommunicationSubTabItemStyle"
               TargetType="TabItem">
            <Setter Property="Foreground" Value="#D0D7DE"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder"
                                Height="33"
                                Background="#4F5860"
                                BorderBrush="#95A5B0"
                                BorderThickness="1,1,1,0"
                                CornerRadius="5,5,0,0"
                                Padding="8">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#5F666D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#3B5F70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommunicationSubTabControlStyle"
               TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <UniformGrid Grid.Row="0"
                                         Rows="1"
                                         Columns="2"
                                         IsItemsHost="True"
                                         HorizontalAlignment="Stretch"/>
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#95A5B0"
                                    BorderThickness="1"
                                    CornerRadius="0,0,5,5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="SelectedContent"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- [통신 설정] 입력 TextBox 스타일 -->
        <Style x:Key="CommunicationTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="30"/>
            <Setter Property="Padding"
                    Value="7,4"/>
            <Setter Property="Foreground"
                    Value="#20242A"/>
            <Setter Property="Background"
                    Value="#F4F6F8"/>
            <Setter Property="BorderBrush"
                    Value="#AAB4BE"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- [통신 설정] RTSP 선택 ComboBox 스타일 -->
        <Style x:Key="CommunicationComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="30"/>
            <Setter Property="Padding"
                    Value="7,3"/>
            <Setter Property="Foreground"
                    Value="#20242A"/>
            <Setter Property="Background"
                    Value="#F4F6F8"/>
            <Setter Property="BorderBrush"
                    Value="#AAB4BE"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
        </Style>

        <!-- [통신 설정] 상태 표시 원형 -->
        <Style x:Key="ConnectionStatusDotStyle"
               TargetType="Ellipse">
            <Setter Property="Width"
                    Value="8"/>
            <Setter Property="Height"
                    Value="8"/>
            <Setter Property="Fill"
                    Value="#FF6B6B"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <!--
            [DEMO UI] 회사 로고 공용 패널

            IR 영상 하단과 메인 화면 하단에서 동일한 배경 및 로고를
            사용하도록 하나의 Template으로 공통 관리한다.
        -->
        <ControlTemplate x:Key="DemoCompanyLogoPanelTemplate"
                         TargetType="Control">
            <Border Background="#15191E"
                    BorderBrush="#4F6773"
                    BorderThickness="2"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Grid>
                    <Image Source="/Images/Demo/BackPanel.png"
                           Stretch="Fill"
                           Opacity="0.72"/>

                    <Border Margin="12"
                            Background="Black"
                            CornerRadius="3">
                        <Image Source="/Images/Demo/GlobalSystemsLogo.png"
                               Stretch="Uniform"
                               Margin="24"/>
                    </Border>
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- [DEMO UI] 글로벌시스템스 현재 위치 오프라인 지도

            외부 API 또는 인터넷 연결 상태와 관계없이 데모 현장에서
        항상 동일한 회사 위치 지도를 표시하도록 로컬 Resource를 사용한다. -->
        <ControlTemplate x:Key="DemoCompanyMapPanelTemplate"
                         TargetType="Control">
            <Border Background="#15191E"
                    BorderBrush="#4F6773"
                    BorderThickness="2"
                    CornerRadius="5"
                    ClipToBounds="True">
                <Grid Background="Black">
                    <!--
                        장비 연결 전 / 연결 해제 상태에서는
                        지도 영역을 기존 GLOBAL SYSTEMS 로고 화면으로 유지한다.
                    -->
                    <Image Source="/Images/Demo/GlobalSystemsLogo.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility"
                                        Value="Visible"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ControlAgentConnectionStatusText,
                                                         Mode=OneWay}"
                                                 Value="Connected">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- 장비 연결 완료 후 실제 지도 이미지를 표시한다. -->
                    <Image Source="/Images/Demo/GlobalSystemsTacticalMap.png"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ControlAgentConnectionStatusText,
                                                         Mode=OneWay}"
                                                 Value="Connected">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>
            </Border>
        </ControlTemplate>

    </Window.Resources>

    <!--
        메인 화면 전체 레이아웃

        1920 x 1080 기준 레이아웃을 유지하면서 창이 작아지면
        전체 UI를 균일 축소하고, 4K처럼 창이 커지면 비율에 맞게
        균일 확대한다.
        우측/하단 내부 ScrollViewer는 그대로 동작하므로
        탭과 메뉴가 화면 밖으로 잘리지 않는다.
    -->
    <Border x:Name="WindowFrameBorder"
            Background="#2C313A"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid Background="#2C313A">
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--
                [DEMO UI] 사용자 정의 Window Title Bar

                기본 Window Frame을 사용하지 않는 데모 화면에서
                창 이동 / 최소화 / 최대화 / 종료 기능을 제공한다.
            -->
            <Border Grid.Row="0"
                    Background="#46515A"
                    BorderBrush="#71808A"
                    BorderThickness="0,0,0,1"
                    CornerRadius="7,7,0,0">
                <Grid>
                    <TextBlock Text="[REI] EO/IR VIDEO MONITORING &amp; PTZF CONTROL VIEWER"
                               Margin="12,0,0,0"
                               Foreground="#D8E3EA"
                               FontSize="13"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Width="48"
                                ToolTip="최소화"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Click="MinimizeWindowButton_Click">
                            <Border Width="11"
                                    Height="1"
                                    Background="White"
                                    VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="MaximizeRestoreWindowButton"
                                Width="48"
                                ToolTip="최대화"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Click="MaximizeRestoreWindowButton_Click">
                            <Grid Width="14" Height="14">
                                <Border x:Name="MaximizeWindowGlyph"
                                        Width="10" Height="10"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                <Grid x:Name="RestoreWindowGlyph"
                                      Visibility="Collapsed">
                                    <Border Width="9" Height="9"
                                            BorderBrush="White"
                                            BorderThickness="1"
                                            Margin="0,0,3,3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"/>
                                    <Border Width="9" Height="9"
                                            BorderBrush="White"
                                            BorderThickness="1"
                                            Background="#46515A"
                                            Margin="3,3,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"/>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Content="×"
                                Width="48"
                                Background="#8E3030"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="18"
                                Click="CloseWindowButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Viewbox Grid.Row="1"
                     Stretch="Uniform"
                     StretchDirection="Both"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">
                <Grid Width="1900"
                      Height="1060"
                      Margin="10"
                      Background="#2C313A">

                    <Grid.RowDefinitions>
                        <!-- 영상 영역과 하단 설정 영역의 최종 배치 비율 -->
                        <RowDefinition Height="3.0*"/>
                        <RowDefinition Height="1.2*"/>
                    </Grid.RowDefinitions>

                    <!--
                        [DEMO UI] 영상 / 회사 로고 / 장비 제어 통합 영역

                        기존 UI와 동일하게 EO / IR 영상을 상단 전체 높이에 배치하고,
                        하단에는 하나의 회사 로고 패널만 표시한다.

                        영상과 AI Overlay는 UniformToFill을 함께 사용한다.
                        원본 종횡비는 유지하면서 영역 밖 가장자리만 잘라
                        EO / IR 영상 영역에 검은 여백이 남지 않도록 구성한다.
                    -->
                    <Grid Grid.RowSpan="2">
                        <Grid.RowDefinitions>
                            <!-- 기존 UI 비율을 유지하는 EO / IR 영상 영역 -->
                            <RowDefinition Height="650"/>

                            <!-- 기존 하단 AI 패널 높이에 맞춘 단일 회사 로고 영역 -->
                            <RowDefinition Height="410"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <!-- [EO] 영상 영역 -->
                            <ColumnDefinition Width="1000"/>

                            <!-- [IR] 영상 및 보조 로고 영역 -->
                            <ColumnDefinition Width="440"/>

                            <!-- 장비 제어 패널 -->
                            <ColumnDefinition Width="450"/>
                        </Grid.ColumnDefinitions>

                        <!-- [좌측] 큰 영상 -->
                        <Border x:Name="EoVideoBorder"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="5,5,10,0"
                                Background="Black"
                                BorderBrush="#5A5A5A"
                                BorderThickness="2"
                                PreviewMouseLeftButtonDown="EoVideoBorder_PreviewMouseLeftButtonDown"
                                MouseLeave="VideoBorder_MouseLeave"
                                ToolTip="더블클릭: EO 영상 분리 창 열기">
                            <Grid ClipToBounds="True">

                                <!-- [EO] 영상 -->
                                <Image Source="{Binding EOCameraImage}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="LowQuality"
                                       SnapsToDevicePixels="True"
                                       UseLayoutRounding="True"/>

                                <!-- [AI] [Bounding Box] [Overlay] -->
                                <Viewbox Stretch="UniformToFill"
                                         Visibility="Visible"
                                         IsHitTestVisible="False">

                                    <ItemsControl ItemsSource="{Binding EoDetectionBoxes}"
                                                  Width="{Binding EoVideoWidth}"
                                                  Height="{Binding EoVideoHeight}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="{Binding Width,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Height="{Binding Height,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        ClipToBounds="True"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left"
                                                        Value="{Binding Left}"/>
                                                <Setter Property="Canvas.Top"
                                                        Value="{Binding Top}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- [AI] [Bounding Box] 표시 영역 -->
                                                <Grid>
                                                    <!-- [AI] 탐지 객체 [Bounding Box] -->
                                                    <Rectangle Width="{Binding Width}"
                                                               Height="{Binding Height}"
                                                               Stroke="#FFFF0000"
                                                               StrokeThickness="4"/>
                                                    <!-- [AI] 탐지 객체 이름 / 정확도 표시 -->
                                                    <Border Background="#FFFF0000"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Padding="5,1"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </Viewbox>

                                <!-- [EO] 영상 중앙 십자선 [Overlay]

                                    RTSP 원본 Frame 또는 AI Bounding Box Canvas에
                                    직접 그리지 않고 영상 Grid 중앙에 별도 표시한다.
                                따라서 Zoom In / Out 중에도 화면 중앙에 고정된다. -->
                                <Control Template="{StaticResource CenterCrosshairTemplate}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Panel.ZIndex="30"
                                         IsHitTestVisible="False">
                                    <Control.Style>
                                        <Style TargetType="Control">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCrosshairVisible}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Control.Style>
                                </Control>

                                <!--
                                    EO 영상 연결 전 / 연결 해제 상태에서는
                                    실제 영상과 Overlay를 가리고 GLOBAL SYSTEMS 로고를 표시한다.
                                -->
                                <Border Panel.ZIndex="90"
                                        Background="Black"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EoStatusText,
                                                                     Mode=OneWay}"
                                                             Value="[EO] Connected">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>
                                                <!-- 2026-08-14: Keep video visible for duplicate connection requests. -->
                                                <DataTrigger Binding="{Binding EoStatusText}" Value="Already Connected...">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Image Source="/Images/Demo/GlobalSystemsLogo.png"
                                           Stretch="Uniform"
                                           Margin="24"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- 안내 문자 (왼쪽 상하단에 보이게) -->
                                <TextBlock Text="{Binding EoStatusText}"
                                           Panel.ZIndex="100"
                                           Margin="0,0,8,2"
                                           Foreground="#7FB3E6"
                                           FontSize="15.5"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- [IR] 영상 전체 Container

                            R / T 영상 전환 시 IR 영상과
                            AI Overlay, 십자선, 상태 문자를 함께 이동시킨다.

                            내부 Image Binding만 바꾸는 것이 아니라
                            Container 자체의 Grid.Column을 변경하므로
                        영상 관련 Overlay도 동일한 위치로 함께 이동한다. -->
                        <Grid x:Name="IrVideoContainer"
                              Grid.Row="0"
                              Grid.Column="1"
                              Height="365"
                              VerticalAlignment="Top"
                              Margin="0,5,10,0">

                            <Border x:Name="IrVideoBorder"
                                    Background="Black"
                                    BorderBrush="#5A5A5A"
                                    BorderThickness="2"
                                    PreviewMouseLeftButtonDown="IrVideoBorder_PreviewMouseLeftButtonDown"
                                    MouseLeave="VideoBorder_MouseLeave"
                                    ToolTip="더블클릭: IR 영상 분리 창 열기">

                                <Grid ClipToBounds="True">

                                    <!-- [IR] 영상 -->
                                    <Image Source="{Binding IRCameraImage}"
                                           Stretch="UniformToFill"/>

                                    <!-- [AI] [Bounding Box] [Overlay] -->
                                    <Viewbox Stretch="UniformToFill"
                                             IsHitTestVisible="False">

                                        <ItemsControl ItemsSource="{Binding IrDetectionBoxes}"
                                                      Width="{Binding IrVideoWidth}"
                                                      Height="{Binding IrVideoHeight}">

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="{Binding Width,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            Height="{Binding Height,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            ClipToBounds="True"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left"
                                                            Value="{Binding Left}"/>
                                                    <Setter Property="Canvas.Top"
                                                            Value="{Binding Top}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- [AI] [Bounding Box] 표시 영역 -->
                                                    <Grid>

                                                        <!-- [AI] 탐지 객체 [Bounding Box] -->
                                                        <Rectangle Width="{Binding Width}"
                                                                   Height="{Binding Height}"
                                                                   Stroke="#FFFF0000"
                                                                   StrokeThickness="4"/>

                                                        <!-- [AI] 탐지 객체 이름 / 정확도 표시 -->
                                                        <Border Background="#FFFF0000"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top">

                                                            <TextBlock Text="{Binding DisplayText}"
                                                                       Foreground="White"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Padding="5,1"/>
                                                        </Border>

                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </Viewbox>

                                    <!-- [IR] 영상 중앙 십자선 [Overlay]

                                        EO 영상과 동일한 Template 및 표시 상태를 사용하여
                                    두 영상의 중앙 기준점을 동일하게 확인한다. -->
                                    <Control Template="{StaticResource CenterCrosshairTemplate}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Panel.ZIndex="30"
                                             IsHitTestVisible="False">
                                        <Control.Style>
                                            <Style TargetType="Control">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCrosshairVisible}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Control.Style>
                                    </Control>

                                    <!--
                                        IR 영상 연결 전 / 연결 해제 상태에서는
                                        실제 영상과 Overlay를 가리고 GLOBAL SYSTEMS 로고를 표시한다.
                                    -->
                                    <Border Panel.ZIndex="90"
                                            Background="Black"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>

                                                <Style.Triggers>
                                                <DataTrigger Binding="{Binding IrStatusText,
                                                                     Mode=OneWay}"
                                                             Value="[IR] Connected">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>
                                                <!-- 2026-08-14: Keep video visible for duplicate connection requests. -->
                                                <DataTrigger Binding="{Binding IrStatusText}" Value="Already Connected...">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Image Source="/Images/Demo/GlobalSystemsLogo.png"
                                               Stretch="Uniform"
                                               Margin="24"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- [IR] 상태 표시 -->
                                    <TextBlock Text="{Binding IrStatusText}"
                                               Panel.ZIndex="100"
                                               Margin="0,0,8,2"
                                               Foreground="#C4B5FD"
                                               FontSize="15.5"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               IsHitTestVisible="False"/>

                                </Grid>

                            </Border>

                        </Grid>

                        <!-- [DEMO UI] IR 하단 글로벌시스템스 위치 지도 -->
                        <Control x:Name="CompanyMapPanel"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Height="275"
                                 VerticalAlignment="Bottom"
                                 Margin="0,5,10,0"
                                 Template="{StaticResource DemoCompanyMapPanelTemplate}"/>

                        <!--
                            [이전 배치] IR 하단 고정 상태 영역

                            통신 설정 / 운용 제어 탭에서 상태 카드를 분리하여
                            IR 영상 아래의 여유 공간에 항상 표시한다.
                            제어 탭의 세로 공간을 확보하고 스크롤 발생을 줄인다.
                        -->
                        <Grid Grid.Row="0"
                              Grid.Column="1"
                              Visibility="Collapsed"
                              Height="275"
                              VerticalAlignment="Bottom"
                              Margin="0,5,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="185"/>
                                <RowDefinition Height="85"/>
                            </Grid.RowDefinitions>

                            <!-- 현재 PTZF 상태 -->
                            <Border Grid.Row="0"
                                    Background="#4E555C"
                                    BorderBrush="#95A5B0"
                                    BorderThickness="1.5"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,0,0,5">
                                <StackPanel>
                                    <TextBlock Text="CURRENT STATUS"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="ROOFTOP"
                                                Height="25"
                                                Margin="2,0"
                                                IsEnabled="{Binding IsOperationCommandEnabled}"
                                                Command="{Binding ShowRooftopStatusCommand}"/>
                                        <Button Grid.Column="1"
                                                Content="ENVIRONMENT"
                                                Height="25"
                                                Margin="2,0"
                                                IsEnabled="{Binding IsOperationCommandEnabled}"
                                                Command="{Binding ShowEnvironmentStatusCommand}"/>
                                    </Grid>

                                    <TextBlock Text="{Binding CurrentStatusEquipmentText}"
                                               Foreground="#8FD3FF"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,5"/>

                                    <Border Background="#343A40"
                                            BorderBrush="#6C757D"
                                            BorderThickness="1"
                                            Padding="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding CurrentPanText, StringFormat=Pan : {0}}" Foreground="White"/>
                                                <TextBlock Text="{Binding CurrentTiltText, StringFormat=Tilt : {0}}" Foreground="White"/>
                                                <TextBlock Text="{Binding CurrentEoZoomText, StringFormat=EO Zoom : {0}}" Foreground="White"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding CurrentEoFocusText, StringFormat=EO Focus : {0}}" Foreground="White"/>
                                                <TextBlock Text="{Binding CurrentIrZoomText, StringFormat=IR Zoom : {0}}" Foreground="White"/>
                                                <TextBlock Text="{Binding CurrentIrFocusText, StringFormat=IR Focus : {0}}" Foreground="White"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 전체 연결 상태 -->
                            <Border Grid.Row="1"
                                    Background="#5F666D"
                                    BorderBrush="#95A5B0"
                                    BorderThickness="1.5"
                                    CornerRadius="4"
                                    Padding="7">
                                <StackPanel>
                                    <TextBlock Text="CONNECTION STATUS"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,5"/>
                                    <Border Background="#40464D"
                                            BorderBrush="#76818B"
                                            BorderThickness="1"
                                            Padding="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.22*"/>
                                                <ColumnDefinition Width="0.78*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="POWER"
                                                       Foreground="#D0D7DE"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center">
                                                <Run Text="CONTROL:" Foreground="#4FD1C5"/><Run Text="{Binding CurrentControlPowerText, Mode=OneWay}" Foreground="#9FE870"/><Run Text=" / " Foreground="#D0D7DE"/><Run Text="EO:" Foreground="#7DD3FC"/><Run Text="{Binding CurrentEoPowerText, Mode=OneWay}" Foreground="#9FE870"/><Run Text=" / " Foreground="#D0D7DE"/><Run Text="IR:" Foreground="#C4B5FD"/><Run Text="{Binding CurrentIrPowerText, Mode=OneWay}" Foreground="#9FE870"/><Run Text=" / " Foreground="#D0D7DE"/><Run Text="AI:" Foreground="#FFD166"/><Run Text="{Binding AiPowerStatusText, Mode=OneWay}" Foreground="#9FE870"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--
                            [DEMO UI] 하단 정적 파노라마 영역

                            실시간 Stitching 전 단계의 임시 운용 기능으로,
                            기본 옥상 파노라마 또는 사용자가 선택한 JPG / PNG 이미지를
                            한 장 표시한다. 추후 Pan 값 기반 현재 시점 표시를 추가할 수
                            있도록 영상과 조작 버튼을 독립된 Grid로 구성한다.
                        -->
                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="5,5,10,5"
                                Background="#10161C"
                                BorderBrush="#4F6773"
                                BorderThickness="2"
                                CornerRadius="5"
                                ClipToBounds="True">
                            <Grid>

                                <Image x:Name="PanoramaImage"
                                       Source="/Images/Demo/DefaultRooftopPanorama.jpg"
                                       Stretch="Uniform"
                                       Cursor="Hand"
                                       ToolTip="더블 클릭하여 파노라마 확대 보기"
                                       MouseLeftButtonDown="PanoramaImage_MouseLeftButtonDown"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <!--
                                        2026-08-18: 초광폭 파노라마를 UniformToFill로
                                        표시하면 좌우가 잘리므로 전체 이미지가 보이는
                                        Uniform 방식으로 변경한다.

                                        파노라마 Source는 유지하되 장비 연결 상태에 따라
                                        화면 표시만 제어한다. 연결 해제 후 다시 연결하면
                                        사용자가 불러온 파노라마도 그대로 다시 표시된다.
                                    -->
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ControlAgentConnectionStatusText,
                                                                     Mode=OneWay}"
                                                             Value="Connected">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <Border VerticalAlignment="Top"
                                        HorizontalAlignment="Stretch"
                                        Height="46"
                                        Background="#B0151D24">
                                    <Grid Margin="12,6">
                                        <TextBlock x:Name="PanoramaFileNameText"
                                                   Text="ROOFTOP PANORAMA / DEFAULT IMAGE"
                                                   Foreground="#AFC8D8"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <StackPanel.Resources>
                                                <!--
                                                    2026-08-18: 촬영/정합 중 비활성 버튼도
                                                    밝은 배경 위에 문구가 명확히 보이도록
                                                    비활성 Foreground와 Opacity를 고정한다.
                                                -->
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground"
                                                            Value="White"/>
                                                    <Setter Property="Background"
                                                            Value="#315D77"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="#7FB3E6"/>
                                                    <Setter Property="Opacity"
                                                            Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                            <Setter Property="Foreground"
                                                                    Value="#26343D"/>
                                                            <Setter Property="Background"
                                                                    Value="#DCE2E6"/>
                                                            <Setter Property="BorderBrush"
                                                                    Value="#8797A1"/>
                                                            <Setter Property="Opacity"
                                                                    Value="1"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Resources>
                                            <!-- 2026-08-18: 파일 선택 중복 기능을 실제 EO 360도 자동 촬영으로 교체 -->
                                            <Button x:Name="NewPanoramaButton"
                                                    Content="360° 파노라마 촬영"
                                                    Width="165"
                                                    Margin="0,0,8,0"
                                                    Click="NewPanoramaButton_Click"/>
                                            <Button x:Name="LoadPanoramaImageButton"
                                                    Content="파노라마 불러오기"
                                                    Width="145"
                                                    Click="LoadPanoramaImageButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="PanoramaEmptyText"
                                           Text="파노라마 이미지가 없습니다."
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#7FB3E6"
                                           FontSize="16"
                                           FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- 우측 통신 설정 / 운용 제어 패널 -->
                        <Border Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                Margin="0,5,8,0"
                                Background="#646A71"
                                BorderBrush="#8B949E"
                                BorderThickness="2"
                                CornerRadius="5"
                                Padding="8,8,10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!--
                                    [DEMO UI] TORUSS 브랜드 및 장비 제어 패널 제목

                                    데모 화면에서 제품 브랜드를 우선 확인할 수 있도록
                                    속도 설정과 운용 제어 UI 상단에 고정 표시한다.
                                -->
                                <StackPanel Grid.Row="0"
                                            Margin="0,0,0,8">
                                    <Image Source="/Images/Demo/TorussLogo.png"
                                           Height="58"
                                           Margin="0,0,0,10"
                                           HorizontalAlignment="Stretch"
                                           Stretch="Uniform"/>

                                    <TextBlock Text="장비 제어"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <!--
                                    [PAN / TILT] Pelco-D 공통 속도 제어

                                    연속 이동 명령의 Data1(Pan) / Data2(Tilt)에 적용하며,
                                    이동 중 값을 변경해도 현재 방향을 유지한 채 즉시 재송신한다.
                                    장비 허용 범위 0~63 중 운용 UI 범위는 0~50으로 제한한다.
                                -->
                                <Border Grid.Row="1"
                                        Margin="0,0,0,7"
                                        Background="#5F666D"
                                        BorderBrush="#95A5B0"
                                        BorderThickness="1.5"
                                        CornerRadius="5"
                                        Padding="10,7">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="PAN / TILT SPEED"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       FontWeight="Bold"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PanTiltSpeedLevel,
                                                               StringFormat={}LEVEL : {0} / 50}"
                                                       Foreground="#D0D7DE"
                                                       FontSize="12"
                                                       FontWeight="Bold"/>
                                        </Grid>

                                        <Slider Grid.Row="1"
                                                Minimum="5"
                                                Maximum="50"
                                                TickFrequency="5"
                                                SmallChange="5"
                                                LargeChange="5"
                                                TickPlacement="BottomRight"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding PanTiltSpeedLevel,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsPanTiltSpeedControlEnabled}"
                                                Height="30"/>
                                    </Grid>
                                </Border>

                                <TabControl Grid.Row="2"
                                            Background="#5F666D"
                                            BorderBrush="#95A5B0"
                                            BorderThickness="1"
                                            Padding="4,4,6,4"
                                            Margin="0"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            SelectedIndex="{Binding SelectedRightPanelTabIndex, Mode=TwoWay}"
                                            IsEnabled="{Binding IsMainControlEnabled}"
                                            Style="{StaticResource TopRightPanelTabControlStyle}"
                                            ItemContainerStyle="{StaticResource TopRightPanelTabItemStyle}">

                                    <!-- Control Agent 통신 연결 설정 -->
                                    <TabItem Header="통신 설정">
                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <!-- 통신 설정 하위 탭 영역 -->
                                                <RowDefinition Height="*"/>

                                                <!-- 항상 표시하는 전체 연결 상태 영역 -->
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Control Agent 및 EO / IR RTSP 통합 설정 카드 -->
                                            <Border Grid.Row="0"
                                                    IsEnabled="{Binding IsOperationCommandEnabled}"
                                                    Background="#5F666D"
                                                    BorderBrush="#95A5B0"
                                                    BorderThickness="1.5"
                                                    CornerRadius="5"
                                                    Padding="8"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- 통신 설정 카드 제목 -->
                                                    <TextBlock Grid.Row="0"
                                                               Text="COMMUNICATION SETTING"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,10"/>

                                                    <Border Grid.Row="1"
                                                            Background="#4B5259"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            ClipToBounds="True">
                                                        <TabControl Background="#4B5259"
                                                                    BorderThickness="0"
                                                                    Padding="0"
                                                                    ClipToBounds="True"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    VerticalContentAlignment="Stretch"
                                                                    Style="{StaticResource CommunicationSubTabControlStyle}"
                                                                    ItemContainerStyle="{StaticResource CommunicationSubTabItemStyle}">

                                                            <!-- Control Agent 및 EO / IR RTSP 설정 하위 탭 -->
                                                            <TabItem Header="CONTROL / RTSP">
                                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                              HorizontalScrollBarVisibility="Disabled">
                                                                    <StackPanel Margin="7">

                                                                        <!-- [1] Control Agent 제어 TCP 설정 -->
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="85"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <TextBlock Grid.Row="0"
                                                                                       Grid.Column="0"
                                                                                       Text="1. Control Agent TCP"
                                                                                       Foreground="White"
                                                                                       FontWeight="Bold"
                                                                                       VerticalAlignment="Center"/>

                                                                            <StackPanel Grid.Row="0"
                                                                                        Grid.Column="1"
                                                                                        Orientation="Horizontal"
                                                                                        HorizontalAlignment="Right">

                                                                                <!-- Control Agent 연결 상태 표시등 -->
                                                                                <Ellipse Width="8"
                                                                                         Height="8"
                                                                                         Fill="{Binding ControlAgentConnectionStatusColor}"
                                                                                         VerticalAlignment="Center"/>

                                                                                <!-- Control Agent 연결 상태 문자열 -->
                                                                                <TextBlock Text="{Binding ControlAgentConnectionStatusText}"
                                                                                           Foreground="{Binding ControlAgentConnectionStatusColor}"
                                                                                           FontSize="11"
                                                                                           FontWeight="Bold"
                                                                                           Margin="5,0,0,0"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>

                                                                            <TextBlock Grid.Row="1"
                                                                                       Grid.Column="0"
                                                                                       Text="IP ADDRESS"
                                                                                       Foreground="#4FD1C5"
                                                                                       FontSize="11"
                                                                                       Margin="0,10,0,4"/>

                                                                            <TextBlock Grid.Row="1"
                                                                                       Grid.Column="1"
                                                                                       Text="PORT"
                                                                                       Foreground="#4FD1C5"
                                                                                       FontSize="11"
                                                                                       Margin="6,10,0,4"/>

                                                                            <TextBox Grid.Row="2"
                                                                                     Grid.Column="0"
                                                                                     Style="{StaticResource CommunicationTextBoxStyle}"
                                                                                     Text="{Binding ControlAgentIp,
                                                                                             Mode=TwoWay,
                                                                                             UpdateSourceTrigger=PropertyChanged}"/>

                                                                            <TextBox Grid.Row="2"
                                                                                     Grid.Column="1"
                                                                                     Margin="6,0,0,0"
                                                                                     MaxLength="5"
                                                                                     Style="{StaticResource CommunicationTextBoxStyle}"
                                                                                     Text="{Binding ControlAgentPortText,
                                                                                             Mode=TwoWay,
                                                                                             UpdateSourceTrigger=PropertyChanged}"/>
                                                                        </Grid>

                                                                        <!-- Control Agent 설정값 적용 시점 안내 -->
                                                                        <TextBlock Text="※ 입력한 Control Agent IP / Port는 다음 장비 연결 시 적용됩니다."
                                                                                   Foreground="#B8C0C8"
                                                                                   FontSize="10"
                                                                                   TextWrapping="Wrap"
                                                                                   Margin="0,8,0,0"/>

                                                                        <!-- Control Agent와 RTSP 설정 구분선 -->
                                                                        <Border Height="1"
                                                                                Background="#69737C"
                                                                                Margin="0,12,0,10"/>

                                                                        <!-- [2] EO / IR RTSP 카메라 선택 설정 -->
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>

                                                                            <TextBlock Grid.Row="0"
                                                                                       Text="2. RTSP 영상 설정"
                                                                                       Foreground="White"
                                                                                       FontWeight="Bold"
                                                                                       Margin="0,0,0,8"/>

                                                                            <!-- [EO RTSP] 카메라 선택 제목 및 연결 상태 -->
                                                                            <Grid Grid.Row="1"
                                                                                  Margin="0,0,0,5">

                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- [EO] 카메라 선택 항목 제목 -->
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="EO CAMERA"
                                                                                           Foreground="#7DD3FC"
                                                                                           FontSize="11"
                                                                                           FontWeight="Bold"
                                                                                           VerticalAlignment="Center"/>

                                                                                <!-- [EO RTSP] 연결 상태 표시 -->
                                                                                <StackPanel Grid.Column="1"
                                                                                            Orientation="Horizontal"
                                                                                            HorizontalAlignment="Right"
                                                                                            VerticalAlignment="Center">

                                                                                    <!-- [EO RTSP] 연결 상태 표시등 -->
                                                                                    <Ellipse Width="8"
                                                                                             Height="8"
                                                                                             Fill="{Binding EoConnectionStatusColor}"
                                                                                             VerticalAlignment="Center"/>

                                                                                    <!-- [EO RTSP] 연결 상태 문자열 -->
                                                                                    <TextBlock Text="{Binding EoConnectionStatusText}"
                                                                                               Foreground="{Binding EoConnectionStatusColor}"
                                                                                               FontSize="11"
                                                                                               FontWeight="Bold"
                                                                                               Margin="5,0,0,0"
                                                                                               VerticalAlignment="Center"/>

                                                                                </StackPanel>
                                                                            </Grid>

                                                                            <StackPanel Grid.Row="2">
                                                                                <ComboBox Style="{StaticResource CommunicationComboBoxStyle}"
                                                                                          ItemsSource="{Binding EoRtspSourceOptions}"
                                                                                          DisplayMemberPath="DisplayName"
                                                                                          SelectedItem="{Binding SelectedEoRtspSource,
                                                                                                  Mode=TwoWay,
                                                                                                  UpdateSourceTrigger=PropertyChanged}"
                                                                                          IsEditable="False"
                                                                                          MaxDropDownHeight="180"/>

                                                                                <TextBox Margin="0,6,0,0"
                                                                                         Text="{Binding EoSourceAddress,
                                                                                                 Mode=TwoWay,
                                                                                                 UpdateSourceTrigger=PropertyChanged}">
                                                                                    <TextBox.Style>
                                                                                        <Style TargetType="TextBox"
                                                                                               BasedOn="{StaticResource CommunicationTextBoxStyle}">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsEoRtspDirectInput}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBox.Style>
                                                                                </TextBox>
                                                                            </StackPanel>

                                                                            <!-- [IR RTSP] 카메라 선택 제목 및 연결 상태 -->
                                                                            <Grid Grid.Row="3"
                                                                                  Margin="0,10,0,5">

                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- [IR] 카메라 선택 항목 제목 -->
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="IR CAMERA"
                                                                                           Foreground="#C4B5FD"
                                                                                           FontSize="11"
                                                                                           FontWeight="Bold"
                                                                                           VerticalAlignment="Center"/>

                                                                                <!-- [IR RTSP] 연결 상태 표시 -->
                                                                                <StackPanel Grid.Column="1"
                                                                                            Orientation="Horizontal"
                                                                                            HorizontalAlignment="Right"
                                                                                            VerticalAlignment="Center">

                                                                                    <!-- [IR RTSP] 연결 상태 표시등 -->
                                                                                    <Ellipse Width="8"
                                                                                             Height="8"
                                                                                             Fill="{Binding IrConnectionStatusColor}"
                                                                                             VerticalAlignment="Center"/>

                                                                                    <!-- [IR RTSP] 연결 상태 문자열 -->
                                                                                    <TextBlock Text="{Binding IrConnectionStatusText}"
                                                                                               Foreground="{Binding IrConnectionStatusColor}"
                                                                                               FontSize="11"
                                                                                               FontWeight="Bold"
                                                                                               Margin="5,0,0,0"
                                                                                               VerticalAlignment="Center"/>

                                                                                </StackPanel>
                                                                            </Grid>

                                                                            <StackPanel Grid.Row="4">
                                                                                <ComboBox Style="{StaticResource CommunicationComboBoxStyle}"
                                                                                          ItemsSource="{Binding IrRtspSourceOptions}"
                                                                                          DisplayMemberPath="DisplayName"
                                                                                          SelectedItem="{Binding SelectedIrRtspSource,
                                                                                                  Mode=TwoWay,
                                                                                                  UpdateSourceTrigger=PropertyChanged}"
                                                                                          IsEditable="False"
                                                                                          MaxDropDownHeight="180"/>

                                                                                <TextBox Margin="0,6,0,0"
                                                                                         Text="{Binding IrSourceAddress,
                                                                                                 Mode=TwoWay,
                                                                                                 UpdateSourceTrigger=PropertyChanged}">
                                                                                    <TextBox.Style>
                                                                                        <Style TargetType="TextBox"
                                                                                               BasedOn="{StaticResource CommunicationTextBoxStyle}">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsIrRtspDirectInput}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBox.Style>
                                                                                </TextBox>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <!-- 선택값 적용 시점 안내 -->
                                                                        <TextBlock Text="※ 선택한 EO / IR 카메라는 다음 장비 연결 시 적용됩니다."
                                                                                   Foreground="#B8C0C8"
                                                                                   FontSize="10"
                                                                                   TextWrapping="Wrap"
                                                                                   Margin="0,8,0,0"/>

                                                                        <!-- Control Agent + EO / IR 통합 연결 버튼 -->
                                                                        <Grid Margin="0,10,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="8"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <Button Grid.Column="0"
                                                                                    Height="32"
                                                                                    Content="장비 연결"
                                                                                    Style="{StaticResource ConnectButtonStyle}"
                                                                                    Command="{Binding ConnectCommand}"/>

                                                                            <Button Grid.Column="2"
                                                                                    Height="32"
                                                                                    Content="연결 해제"
                                                                                    Style="{StaticResource DisconnectButtonStyle}"
                                                                                    Command="{Binding DisconnectCommand}"/>
                                                                        </Grid>

                                                                    </StackPanel>
                                                                </ScrollViewer>
                                                            </TabItem>

                                                            <!-- AI Detector 연결 및 분석 설정 하위 탭 -->
                                                            <TabItem Header="AI / FIRE DETECTOR">
                                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                              HorizontalScrollBarVisibility="Disabled">
                                                                    <StackPanel Margin="7">

                                                                        <!--
                                                                            [3] AI Detector 통합 설정

                                                                            기존 하단 AI DETECTOR SETTING 패널의 기능을
                                                                            통신 설정 탭 내부로 이동하여 데모 화면의 빈 공간을
                                                                            줄이고 모든 연결 설정을 한 화면에서 관리한다.
                                                                        -->
                                                                        <Border Padding="10"
                                                                                Background="#464D54"
                                                                                BorderBrush="#81909A"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4">
                                                                            <StackPanel>
                                                                                <TextBlock Text="3. AI DETECTOR SETTING"
                                                                                           Foreground="#A9D6E5"
                                                                                           FontWeight="Bold"
                                                                                           HorizontalAlignment="Center"
                                                                                           Margin="0,0,0,10"/>

                                                                                <!-- [AI Agent] IP / Port -->
                                                                                <Grid Margin="0,0,0,10">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="85"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <TextBox Grid.Column="0"
                                                                                             Style="{StaticResource CommunicationTextBoxStyle}"
                                                                                             Text="{Binding AiControlAgentIp,
                                                                                                     Mode=TwoWay,
                                                                                                     UpdateSourceTrigger=PropertyChanged}"/>

                                                                                    <TextBox Grid.Column="1"
                                                                                             Margin="6,0,0,0"
                                                                                             Style="{StaticResource CommunicationTextBoxStyle}"
                                                                                             Text="{Binding AiAgentPort,
                                                                                                     Mode=TwoWay,
                                                                                                     UpdateSourceTrigger=PropertyChanged}"/>
                                                                                </Grid>

                                                                                <!--
                                                                                    AI Agent 수동 연결 / 연결 해제

                                                                                    프로그램 시작 시에는 AI Agent에 자동 연결하지 않으며,
                                                                                    사용자가 각 버튼을 누른 경우에만 연결 상태를 변경한다.
                                                                                -->
                                                                                <UniformGrid Columns="2"
                                                                                             Margin="0,0,0,12">

                                                                                    <Button Content="AI CONNECT"
                                                                                            Height="30"
                                                                                            Margin="0,0,3,0"
                                                                                            Style="{StaticResource AiSettingButtonStyle}"
                                                                                            Background="#1F4F4A"
                                                                                            Command="{Binding ConnectAiAgentCommand}"/>

                                                                                    <Button Content="AI DISCONNECT"
                                                                                            Height="30"
                                                                                            Margin="3,0,0,0"
                                                                                            Style="{StaticResource AiSettingButtonStyle}"
                                                                                            Background="#5A3030"
                                                                                            Command="{Binding DisconnectAiAgentCommand}"/>

                                                                                </UniformGrid>

                                                                                <!-- [AI Detector] 분석 대상 EO / IR RTSP 프리셋 -->
                                                                                <ComboBox Height="28"
                                                                                          Margin="0,0,0,6"
                                                                                          ItemsSource="{Binding EoRtspSourceOptions}"
                                                                                          DisplayMemberPath="DisplayName"
                                                                                          SelectedItem="{Binding SelectedAiEoRtspSource,
                                                                                                  Mode=TwoWay}"/>

                                                                                <TextBox Height="28"
                                                                                         Margin="0,0,0,8"
                                                                                         Text="{Binding AiRtsp0Address,
                                                                                                 Mode=TwoWay,
                                                                                                 UpdateSourceTrigger=PropertyChanged}">
                                                                                    <TextBox.Style>
                                                                                        <Style TargetType="TextBox">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsAiEoRtspDirectInput}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBox.Style>
                                                                                </TextBox>

                                                                                <ComboBox Height="28"
                                                                                          Margin="0,0,0,6"
                                                                                          ItemsSource="{Binding IrRtspSourceOptions}"
                                                                                          DisplayMemberPath="DisplayName"
                                                                                          SelectedItem="{Binding SelectedAiIrRtspSource,
                                                                                                  Mode=TwoWay}"/>

                                                                                <TextBox Height="28"
                                                                                         Margin="0,0,0,10"
                                                                                         Text="{Binding AiRtsp1Address,
                                                                                                 Mode=TwoWay,
                                                                                                 UpdateSourceTrigger=PropertyChanged}">
                                                                                    <TextBox.Style>
                                                                                        <Style TargetType="TextBox">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsAiIrRtspDirectInput}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBox.Style>
                                                                                </TextBox>

                                                                                <Button Content="APPLY AI RTSP"
                                                                                        Height="30"
                                                                                        Margin="0,0,0,12"
                                                                                        Style="{StaticResource AiSettingButtonStyle}"
                                                                                        Background="#263B4A"
                                                                                        Command="{Binding ApplyAiRtspCommand}"/>

                                                                                <!-- [AI Detector] ONNX Mapping -->
                                                                                <Grid Margin="0,0,0,10">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="8"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <ComboBox Grid.Column="0"
                                                                                              Height="28"
                                                                                              ItemsSource="{Binding AiOnnxList}"
                                                                                              DisplayMemberPath="FileName"
                                                                                              SelectedValuePath="Index"
                                                                                              SelectedValue="{Binding AiRtsp0OnnxIndex,
                                                                                                      Mode=TwoWay}"/>

                                                                                    <ComboBox Grid.Column="2"
                                                                                              Height="28"
                                                                                              ItemsSource="{Binding AiOnnxList}"
                                                                                              DisplayMemberPath="FileName"
                                                                                              SelectedValuePath="Index"
                                                                                              SelectedValue="{Binding AiRtsp1OnnxIndex,
                                                                                                      Mode=TwoWay}"/>
                                                                                </Grid>

                                                                                <!-- Confidence / IOU / Box Filter -->
                                                                                <Grid Margin="0,2,0,4">
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                    </Grid.RowDefinitions>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="80"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="42"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <TextBlock Grid.Row="0"
                                                                                               Text="Confidence"
                                                                                               Foreground="White"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <Slider Grid.Row="0"
                                                                                            Grid.Column="1"
                                                                                            Margin="0,2"
                                                                                            Minimum="0"
                                                                                            Maximum="1"
                                                                                            TickFrequency="0.05"
                                                                                            IsSnapToTickEnabled="True"
                                                                                            Value="{Binding AiMappingConfidence,
                                                                                                    Mode=TwoWay}"/>
                                                                                    <TextBlock Grid.Row="0"
                                                                                               Grid.Column="2"
                                                                                               Text="{Binding AiMappingConfidenceText}"
                                                                                               Foreground="White"
                                                                                               VerticalAlignment="Center"/>

                                                                                    <TextBlock Grid.Row="1"
                                                                                               Text="IOU"
                                                                                               Foreground="White"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <Slider Grid.Row="1"
                                                                                            Grid.Column="1"
                                                                                            Margin="0,2"
                                                                                            Minimum="0"
                                                                                            Maximum="1"
                                                                                            TickFrequency="0.05"
                                                                                            IsSnapToTickEnabled="True"
                                                                                            Value="{Binding AiMappingIou,
                                                                                                    Mode=TwoWay}"/>
                                                                                    <TextBlock Grid.Row="1"
                                                                                               Grid.Column="2"
                                                                                               Text="{Binding AiMappingIouText}"
                                                                                               Foreground="White"
                                                                                               VerticalAlignment="Center"/>

                                                                                    <TextBlock Grid.Row="2"
                                                                                               Text="Box Filter"
                                                                                               Foreground="White"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <Slider Grid.Row="2"
                                                                                            Grid.Column="1"
                                                                                            Margin="0,2"
                                                                                            Minimum="0"
                                                                                            Maximum="1"
                                                                                            TickFrequency="0.05"
                                                                                            IsSnapToTickEnabled="True"
                                                                                            Value="{Binding AiDisplayConfidenceThreshold,
                                                                                                    Mode=TwoWay}"/>
                                                                                    <TextBlock Grid.Row="2"
                                                                                               Grid.Column="2"
                                                                                               Text="{Binding AiDisplayConfidenceThresholdText}"
                                                                                               Foreground="White"
                                                                                               VerticalAlignment="Center"/>
                                                                                </Grid>

                                                                                <Grid Margin="0,12,0,0">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="8"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <Button Grid.Column="0"
                                                                                            Content="APPLY MAPPING"
                                                                                            Height="30"
                                                                                            Style="{StaticResource AiSettingButtonStyle}"
                                                                                            Background="#34505F"
                                                                                            Command="{Binding ApplyAiMappingCommand}"/>

                                                                                    <Button Grid.Column="2"
                                                                                            Content="REFRESH AI INFO"
                                                                                            Height="30"
                                                                                            Style="{StaticResource AiSettingButtonStyle}"
                                                                                            Background="#3A4058"
                                                                                            Command="{Binding RefreshAiSettingCommand}"/>
                                                                                </Grid>

                                                                                <CheckBox Content="AUTO TRACKING"
                                                                                          Foreground="#00E676"
                                                                                          FontWeight="Bold"
                                                                                          IsChecked="{Binding IsAutoTrackingEnabled}"
                                                                                          Margin="0,12,0,0"/>

                                                                                <TextBlock Text="{Binding AiSettingStatusText}"
                                                                                           Foreground="#00E676"
                                                                                           FontSize="11"
                                                                                           FontWeight="Bold"
                                                                                           TextWrapping="Wrap"
                                                                                           Margin="0,6,0,0"/>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!--
                                                                            [열영상 팔레트 / 화재 후보 검출 시험]

                                                                            팔레트 제어는 ThermalCamCon 실장비 명령의
                                                                            Address 0x0E / Palette 0x00 ~ 0x09를 사용한다.

                                                                            화재 후보 검출은 방사 온도값이 아닌
                                                                            IR 영상의 밝기 및 적색 계열 픽셀을 분석하는
                                                                            시험 기능이므로 FIRE CANDIDATE로 표시한다.
                                                                        -->
                                                                        <Border Margin="0,14,0,0"
                                                                                Padding="10"
                                                                                Background="#464D54"
                                                                                BorderBrush="#81909A"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4">
                                                                            <StackPanel>
                                                                                <TextBlock Text="4. FIRE DETECTOR SETTING"
                                                                                           Foreground="#A9D6E5"
                                                                                           FontWeight="Bold"
                                                                                           HorizontalAlignment="Center"
                                                                                           Margin="0,0,0,10"/>

                                                                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                                                                    <!-- 2026-08-14: 명령 팔레트와 같은 색으로 식별한다. -->
                                                                                    <!-- 2026-08-14: Neutral initially; color changes only after a successful command. -->
                                                                                    <Button Content="BLACK HOT" Height="30" Margin="0,0,3,0" Foreground="{Binding ThermalBlackHotButtonForeground}" Background="{Binding ThermalBlackHotButtonBackground}" Style="{StaticResource AiSettingButtonStyle}" Command="{Binding SelectThermalBlackHotCommand}"/>
                                                                                    <Button Content="WHITE HOT" Height="30" Margin="3,0" Foreground="{Binding ThermalWhiteHotButtonForeground}" Background="{Binding ThermalWhiteHotButtonBackground}" Style="{StaticResource AiSettingButtonStyle}" Command="{Binding SelectThermalWhiteHotCommand}"/>
                                                                                    <Button Content="RANDOM" Height="30" Margin="3,0,0,0" Foreground="{Binding ThermalRainbowButtonForeground}" Background="{Binding ThermalRainbowButtonBackground}" Style="{StaticResource AiSettingButtonStyle}" Command="{Binding SelectThermalRandomCommand}"/>
                                                                                </UniformGrid>

                                                                                <UniformGrid Columns="3"
                                                                                             Margin="0,0,0,12">
                                                                                    <Button Content="PREV"
                                                                                            Height="30"
                                                                                            Margin="0,0,3,0"
                                                                                            Style="{StaticResource AiSettingButtonStyle}"
                                                                                            Background="#3E515E"
                                                                                            Command="{Binding PreviousThermalPaletteCommand}"/>

                                                                                    <Button Content="NEXT"
                                                                                            Height="30"
                                                                                            Margin="3,0"
                                                                                            Style="{StaticResource AiSettingButtonStyle}"
                                                                                            Background="#3E515E"
                                                                                            Command="{Binding NextThermalPaletteCommand}"/>

                                                                                    <Button Content="NUC"
                                                                                            Height="30"
                                                                                            Margin="3,0,0,0"
                                                                                            Style="{StaticResource AiSettingButtonStyle}"
                                                                                            Background="#665637"
                                                                                            Command="{Binding RequestThermalNucCommand}"/>
                                                                                </UniformGrid>

                                                                                <Button Content="TEST PROGRAM"
                                                                                        Height="30"
                                                                                        Margin="0,0,0,8"
                                                                                        Style="{StaticResource AiSettingButtonStyle}"
                                                                                        Background="#7A3434"
                                                                                        Click="FireDetectorTestProgram_Click"/>

                                                                                <CheckBox Content="FIRE DETECTOR"
                                                                                          Foreground="#FF8A80"
                                                                                          FontWeight="Bold"
                                                                                          IsChecked="{Binding IsThermalFireDetectionEnabled,
                                                                                                  Mode=TwoWay}"
                                                                                          Margin="0,0,0,8"/>

                                                                                <!-- 2026-08-14: FIRE DETECTION BBox grouping can be changed at runtime. -->
                                                                                <TextBlock Text="FIRE DETECTION 구분 방식"
                                                                                           Foreground="White"
                                                                                           FontWeight="Bold"/>
                                                                                <UniformGrid Columns="2" Margin="0,4,0,8">
                                                                                    <Button Content="구분 방식 1"
                                                                                            ToolTip="검출된 전체 화염을 하나의 박스로 표시"
                                                                                            Command="{Binding SelectThermalFireBoxMode1Command}"
                                                                                            Background="{Binding ThermalFireBoxMode1Background}"
                                                                                            Style="{StaticResource AiSettingButtonStyle}"/>
                                                                                    <Button Content="구분 방식 2"
                                                                                            ToolTip="떨어진 화염을 각각의 박스로 표시"
                                                                                            Command="{Binding SelectThermalFireBoxMode2Command}"
                                                                                            Background="{Binding ThermalFireBoxMode2Background}"
                                                                                            Style="{StaticResource AiSettingButtonStyle}"/>
                                                                                </UniformGrid>

                                                                                <TextBlock Text="HOT PIXEL THRESHOLD"
                                                                                           Foreground="White"/>
                                                                                <Slider Minimum="0.05"
                                                                                        Maximum="1"
                                                                                        TickFrequency="0.01"
                                                                                        IsSnapToTickEnabled="True"
                                                                                        Value="{Binding ThermalHotThresholdRatio,
                                                                                                Mode=TwoWay}"
                                                                                        Margin="0,3,0,0"/>
                                                                                <TextBlock Text="{Binding ThermalHotThresholdRatio,
                                                                                                   StringFormat=THRESHOLD : {0:F2}}"
                                                                                           Foreground="#D0D7DE"
                                                                                           HorizontalAlignment="Right"
                                                                                           Margin="0,0,0,8"/>

                                                                                <TextBlock Text="MINIMUM FIRE DETECTOR AREA"
                                                                                           Foreground="White"/>
                                                                                <Slider Minimum="0.0005"
                                                                                        Maximum="0.25"
                                                                                        TickFrequency="0.0005"
                                                                                        IsSnapToTickEnabled="True"
                                                                                        Value="{Binding ThermalMinimumAreaRatio,
                                                                                                Mode=TwoWay}"
                                                                                        Margin="0,3,0,0"/>
                                                                                <TextBlock Text="{Binding ThermalMinimumAreaRatio,
                                                                                                   StringFormat=MIN AREA RATIO : {0:F4}}"
                                                                                           Foreground="#D0D7DE"
                                                                                           HorizontalAlignment="Right"/>

                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </ScrollViewer>
                                                            </TabItem>
                                                        </TabControl>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- 영상 및 장비 상태 카드 -->
                                            <Border Grid.Row="1"
                                                    Background="#5F666D"
                                                    BorderBrush="#95A5B0"
                                                    BorderThickness="1.5"
                                                    CornerRadius="5"
                                                    Padding="8">
                                                <StackPanel>
                                                    <TextBlock Text="CONNECTION STATUS"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,8"/>

                                                    <Border Background="#40464D"
                                                            BorderBrush="#76818B"
                                                            BorderThickness="1"
                                                            Padding="9">
                                                        <TextBlock FontSize="10.5"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="POWER" Foreground="#D0D7DE"/>
                                                            <Run Text=" / " Foreground="#D0D7DE"/>
                                                            <Run Text="TCP:" Foreground="#4FD1C5"/>
                                                            <Run Text="{Binding CurrentControlPowerText, Mode=OneWay}" Foreground="#9FE870"/>
                                                            <Run Text=" / " Foreground="#D0D7DE"/>
                                                            <Run Text="EO:" Foreground="#7DD3FC"/>
                                                            <Run Text="{Binding CurrentEoPowerText, Mode=OneWay}" Foreground="#9FE870"/>
                                                            <Run Text=" / " Foreground="#D0D7DE"/>
                                                            <Run Text="IR:" Foreground="#C4B5FD"/>
                                                            <Run Text="{Binding CurrentIrPowerText, Mode=OneWay}" Foreground="#9FE870"/>
                                                            <Run Text=" / " Foreground="#D0D7DE"/>
                                                            <Run Text="AI:" Foreground="#A9D6E5"/>
                                                            <Run Text="{Binding AiPowerStatusText, Mode=OneWay}" Foreground="#9FE870"/>
                                                            <Run Text=" / " Foreground="#D0D7DE"/>
                                                            <Run Text="FIRE:" Foreground="#A9D6E5"/>
                                                            <Run Text="{Binding FirePowerStatusText, Mode=OneWay}" Foreground="#9FE870"/>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>

                                    <!-- 기존 장비 제어 UI -->
                                    <!-- [운용 제어] 기능군별 화면 분리
                                        우측 최상위 탭은 통신 설정 / 운용 제어 두 개만 유지한다.

                                        CURRENT STATUS는 상단에 항상 표시하고,
                                        실제 제어 기능은 PTZF / PRESET / LENS / SYNC 탭으로 분리한다.

                                        Position 기반 이동 제어는 AI 설정 영역에서 제거하고
                                    PTZF 탭의 PAN / TILT CONTROL 아래에 통합한다. -->
                                    <TabItem Header="운용 제어">
                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <!-- 장비별 CURRENT STATUS 고정 표시 영역 -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- 기능군별 제어 탭 영역 -->
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- [CURRENT STATUS]
                                                옥상장비 / 환경장비 상태 화면은 항상 상단에 유지한다.
                                            제어 탭을 전환하더라도 현재 장비 상태를 계속 확인할 수 있다. -->
                                            <Border Grid.Row="0"
                                                    Background="#4E555C"
                                                    BorderBrush="#95A5B0"
                                                    BorderThickness="1.5"
                                                    Padding="9"
                                                    MaxHeight="250">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel>
                                                        <!-- [CURRENT STATUS] 제목 -->
                                                        <TextBlock Text="CURRENT STATUS"
                                                                   Foreground="White"
                                                                   FontSize="13"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,8"/>

                                                        <!-- 옥상장비 / 환경장비 상태 화면 전환 -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Button x:Name="RooftopStatusButton"
                                                                    Grid.Column="0"
                                                                    Content="ROOFTOP"
                                                                    Height="28"
                                                                    Margin="2"
                                                                    Command="{Binding ShowRooftopStatusCommand}"/>

                                                            <Button x:Name="EnvironmentStatusButton"
                                                                    Grid.Column="1"
                                                                    Content="ENVIRONMENT"
                                                                    Height="28"
                                                                    Margin="2"
                                                                    Command="{Binding ShowEnvironmentStatusCommand}"/>
                                                        </Grid>

                                                        <TextBlock Text="{Binding CurrentStatusEquipmentText}"
                                                                   Foreground="#8FD3FF"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,8"/>

                                                        <!-- 옥상 시험장비 상태 -->
                                                        <Border Background="#343A40"
                                                                BorderBrush="#6C757D"
                                                                BorderThickness="1"
                                                                Padding="8"
                                                                Margin="0,0,0,8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRooftopStatusSelected}"
                                                                                     Value="True">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="75"/>
                                                                    <ColumnDefinition Width="10"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <TextBlock Grid.Row="0"
                                                                           Grid.Column="0"
                                                                           Text="Pan"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Grid.Row="0"
                                                                           Grid.Column="1"
                                                                           Text=":"
                                                                           Foreground="White"/>
                                                                <TextBlock Grid.Row="0"
                                                                           Grid.Column="2"
                                                                           Text="{Binding CurrentPanText}"
                                                                           Foreground="White"/>

                                                                <TextBlock Grid.Row="1"
                                                                           Grid.Column="0"
                                                                           Text="Tilt"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Grid.Row="1"
                                                                           Grid.Column="1"
                                                                           Text=":"
                                                                           Foreground="White"/>
                                                                <TextBlock Grid.Row="1"
                                                                           Grid.Column="2"
                                                                           Text="{Binding CurrentTiltText}"
                                                                           Foreground="White"/>

                                                                <TextBlock Grid.Row="2"
                                                                           Grid.Column="0"
                                                                           Text="EO Zoom"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Grid.Row="2"
                                                                           Grid.Column="1"
                                                                           Text=":"
                                                                           Foreground="White"/>
                                                                <TextBlock Grid.Row="2"
                                                                           Grid.Column="2"
                                                                           Text="{Binding RooftopEoZoomStatusText}"
                                                                           Foreground="White"/>

                                                                <TextBlock Grid.Row="3"
                                                                           Grid.Column="0"
                                                                           Text="EO Focus"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Grid.Row="3"
                                                                           Grid.Column="1"
                                                                           Text=":"
                                                                           Foreground="White"/>
                                                                <TextBlock Grid.Row="3"
                                                                           Grid.Column="2"
                                                                           Text="{Binding RooftopEoFocusStatusText}"
                                                                           Foreground="White"/>

                                                                <TextBlock Grid.Row="4"
                                                                           Grid.Column="0"
                                                                           Text="IR Zoom"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Grid.Row="4"
                                                                           Grid.Column="1"
                                                                           Text=":"
                                                                           Foreground="White"/>
                                                                <TextBlock Grid.Row="4"
                                                                           Grid.Column="2"
                                                                           Text="{Binding RooftopIrZoomStatusText}"
                                                                           Foreground="White"/>

                                                                <!-- [옥상장비] IR Focus 상태 -->
                                                                <TextBlock Grid.Row="5"
                                                                           Grid.Column="0"
                                                                           Text="IR Focus"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>

                                                                <TextBlock Grid.Row="5"
                                                                           Grid.Column="1"
                                                                           Text=":"
                                                                           Foreground="White"/>

                                                                <TextBlock Grid.Row="5"
                                                                           Grid.Column="2"
                                                                           Text="{Binding RooftopIrFocusStatusText}"
                                                                           Foreground="White"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- 환경장비 Web Agent 상태 -->
                                                        <Border Background="#343A40"
                                                                BorderBrush="#6C757D"
                                                                BorderThickness="1"
                                                                Padding="8"
                                                                Margin="0,0,0,8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEnvironmentStatusSelected}"
                                                                                     Value="True">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="75"/>
                                                                    <ColumnDefinition Width="10"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <TextBlock Grid.Row="0"
                                                                           Grid.Column="0"
                                                                           Text="Pan"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Grid.Row="0"
                                                                           Grid.Column="1"
                                                                           Text=":"
                                                                           Foreground="White"/>
                                                                <TextBlock Grid.Row="0"
                                                                           Grid.Column="2"
                                                                           Text="{Binding CurrentPanText}"
                                                                           Foreground="White"/>

                                                                <TextBlock Grid.Row="1"
                                                                           Grid.Column="0"
                                                                           Text="Tilt"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Grid.Row="1"
                                                                           Grid.Column="1"
                                                                           Text=":"
                                                                           Foreground="White"/>
                                                                <TextBlock Grid.Row="1"
                                                                           Grid.Column="2"
                                                                           Text="{Binding CurrentTiltText}"
                                                                           Foreground="White"/>

                                                                <TextBlock Grid.Row="2"
                                                                           Grid.Column="0"
                                                                           Text="EO Zoom"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Grid.Row="2"
                                                                           Grid.Column="1"
                                                                           Text=":"
                                                                           Foreground="White"/>
                                                                <TextBlock Grid.Row="2"
                                                                           Grid.Column="2"
                                                                           Text="{Binding EnvironmentEoZoomStatusText}"
                                                                           Foreground="White"/>

                                                                <!-- [환경장비] EO Focus 상태 -->
                                                                <TextBlock Grid.Row="3"
                                                                           Grid.Column="0"
                                                                           Text="EO Focus"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>

                                                                <TextBlock Grid.Row="3"
                                                                           Grid.Column="1"
                                                                           Text=":"
                                                                           Foreground="White"/>

                                                                <TextBlock Grid.Row="3"
                                                                           Grid.Column="2"
                                                                           Text="{Binding EnvironmentEoFocusStatusText}"
                                                                           Foreground="White"/>

                                                                <TextBlock Grid.Row="4"
                                                                           Grid.Column="0"
                                                                           Text="IR Zoom"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Grid.Row="4"
                                                                           Grid.Column="1"
                                                                           Text=":"
                                                                           Foreground="White"/>
                                                                <TextBlock Grid.Row="4"
                                                                           Grid.Column="2"
                                                                           Text="{Binding EnvironmentIrZoomStatusText}"
                                                                           Foreground="White"/>

                                                                <!-- [환경장비] IR Focus 상태 -->
                                                                <TextBlock Grid.Row="5"
                                                                           Grid.Column="0"
                                                                           Text="IR Focus"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>

                                                                <TextBlock Grid.Row="5"
                                                                           Grid.Column="1"
                                                                           Text=":"
                                                                           Foreground="White"/>

                                                                <TextBlock Grid.Row="5"
                                                                           Grid.Column="2"
                                                                           Text="{Binding EnvironmentIrFocusStatusText}"
                                                                           Foreground="White"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Border>

                                            <!-- [운용 제어 기능 탭]
                                                PTZF   : Overlay, Pan / Tilt 및 Position 기반 Zoom / Focus 이동 제어
                                                PRESET : 프리셋 추가 / 제거 / 이동 및 오토 스캔 제어
                                                LENS   : EO / IR 연속 Zoom 및 Focus 수동 제어
                                            SYNC   : Web Agent 기준 EO / IR Zoom / Focus 단계 동기화 -->
                                            <TabControl Grid.Row="1"
                                                        IsEnabled="{Binding IsOperationCommandEnabled}"
                                                        Margin="0,8,0,0"
                                                        Background="#5F666D"
                                                        BorderBrush="#95A5B0"
                                                        BorderThickness="1"
                                                        Padding="3"
                                                        HorizontalContentAlignment="Stretch"
                                                        SelectedIndex="{Binding SelectedOperationControlTabIndex, Mode=TwoWay}"
                                                        ItemContainerStyle="{StaticResource RightPanelTabItemStyle}">

                                                <!-- [PTZF] Overlay / Pan / Tilt / Zoom / Focus 이동 제어 -->
                                                <TabItem Header="PTZF"
                                                         IsEnabled="{Binding IsOperationCommandEnabled}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <StackPanel Margin="4,2,2,5">
                                                            <!-- [EO / IR] 영상 Overlay 표시 제어 -->
                                                            <Border Margin="0,5,5,0"
                                                                    Background="#5F666D"
                                                                    BorderBrush="#95A5B0"
                                                                    BorderThickness="1.5"
                                                                    Padding="12">

                                                                <StackPanel>

                                                                    <!-- 제목 -->
                                                                    <TextBlock Text="DISPLAY OVERLAY"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="White"
                                                                               FontWeight="Bold"
                                                                               Margin="0,0,0,8"/>

                                                                    <!-- EO / IR 중앙 십자선 활성화 / 비활성화 Toggle 버튼 -->
                                                                    <Button Content="{Binding CrosshairButtonText}"
                                                                            Command="{Binding ToggleCrosshairCommand}"
                                                                            Height="34"
                                                                            Foreground="White"
                                                                            FontWeight="Bold"
                                                                            BorderThickness="1"
                                                                            BorderBrush="#95A5B0"
                                                                            Cursor="Hand">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Background"
                                                                                        Value="#4A4F55"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCrosshairVisible}"
                                                                                                 Value="True">
                                                                                        <Setter Property="Background"
                                                                                                Value="{Binding CrosshairBrush}"/>
                                                                                        <Setter Property="BorderBrush"
                                                                                                Value="{Binding CrosshairBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <Trigger Property="IsMouseOver"
                                                                                             Value="True">
                                                                                        <Setter Property="Opacity"
                                                                                                Value="0.85"/>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>

                                                                    <!-- 기능 안내 -->
                                                                    <TextBlock Text="※ EO / IR 화면의 중앙 기준점을 동시에 표시하거나 숨깁니다."
                                                                               Foreground="#D0D7DE"
                                                                               FontSize="10"
                                                                               TextWrapping="Wrap"
                                                                               HorizontalAlignment="Center"
                                                                               TextAlignment="Center"
                                                                               Margin="0,7,0,0"/>

                                                                </StackPanel>

                                                            </Border>
                                                            <!-- [PAN] / [TILT] 제어 -->
                                                            <Border Grid.Row="2"
                                                                    Margin="0,5,5,7"
                                                                    Background="#5F666D"
                                                                    BorderBrush="#95A5B0"
                                                                    BorderThickness="1.5"
                                                                    Padding="12">

                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <!-- 제목 -->
                                                                    <TextBlock Text="PAN / TILT CONTROL"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="White"
                                                                               FontWeight="Bold"
                                                                               Margin="0,0,0,5"/>

                                                                    <!-- [PT] 방향키 제어 버튼 영역 -->
                                                                    <Grid Grid.Row="1"
                                                                          Width="120"
                                                                          Height="120"
                                                                          HorizontalAlignment="Center">

                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition/>
                                                                            <RowDefinition/>
                                                                            <RowDefinition/>
                                                                        </Grid.RowDefinitions>

                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition/>
                                                                            <ColumnDefinition/>
                                                                            <ColumnDefinition/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- [PAN LEFT + TILT UP] 좌측 상단 대각선 -->
                                                                        <Button Grid.Row="0"
                                                                                Grid.Column="0"
                                                                                Content="↖"
                                                                                Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                                                PreviewMouseDown="PanLeftTiltUp_MouseDown"
                                                                                PreviewMouseUp="MoveStop_MouseUp"
                                                                                MouseLeave="MoveStop_MouseLeave"/>

                                                                        <!-- [TILT] [UP] -->
                                                                        <Button Grid.Row="0"
                                                                                Grid.Column="1"
                                                                                Content="▲"
                                                                                Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                                                PreviewMouseDown="TiltUp_MouseDown"
                                                                                PreviewMouseUp="MoveStop_MouseUp"
                                                                                MouseLeave="MoveStop_MouseLeave"/>

                                                                        <!-- [PAN RIGHT + TILT UP] 우측 상단 대각선 -->
                                                                        <Button Grid.Row="0"
                                                                                Grid.Column="2"
                                                                                Content="↗"
                                                                                Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                                                PreviewMouseDown="PanRightTiltUp_MouseDown"
                                                                                PreviewMouseUp="MoveStop_MouseUp"
                                                                                MouseLeave="MoveStop_MouseLeave"/>

                                                                        <!-- [PAN] [LEFT] -->
                                                                        <Button Grid.Row="1"
                                                                                Grid.Column="0"
                                                                                Content="◀"
                                                                                Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                                                PreviewMouseDown="PanLeft_MouseDown"
                                                                                PreviewMouseUp="MoveStop_MouseUp"
                                                                                MouseLeave="MoveStop_MouseLeave"/>

                                                                        <!-- [STOP] -->
                                                                        <Border Grid.Row="1"
                                                                                Grid.Column="1"
                                                                                Margin="5"
                                                                                Background="#3F454B"
                                                                                BorderBrush="#8B949E"
                                                                                BorderThickness="1">

                                                                            <Button Content="STOP"
                                                                                    Style="{StaticResource StopButtonStyle}"
                                                                                    Command="{Binding StopMoveCommand}"/>
                                                                        </Border>

                                                                        <!-- [PAN] [RIGHT] -->
                                                                        <Button Grid.Row="1"
                                                                                Grid.Column="2"
                                                                                Content="▶"
                                                                                Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                                                PreviewMouseDown="PanRight_MouseDown"
                                                                                PreviewMouseUp="MoveStop_MouseUp"
                                                                                MouseLeave="MoveStop_MouseLeave"/>

                                                                        <!-- [PAN LEFT + TILT DOWN] 좌측 하단 대각선 -->
                                                                        <Button Grid.Row="2"
                                                                                Grid.Column="0"
                                                                                Content="↙"
                                                                                Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                                                PreviewMouseDown="PanLeftTiltDown_MouseDown"
                                                                                PreviewMouseUp="MoveStop_MouseUp"
                                                                                MouseLeave="MoveStop_MouseLeave"/>

                                                                        <!-- [TILT] [DOWN] -->
                                                                        <Button Grid.Row="2"
                                                                                Grid.Column="1"
                                                                                Content="▼"
                                                                                Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                                                PreviewMouseDown="TiltDown_MouseDown"
                                                                                PreviewMouseUp="MoveStop_MouseUp"
                                                                                MouseLeave="MoveStop_MouseLeave"/>

                                                                        <!-- [PAN RIGHT + TILT DOWN] 우측 하단 대각선 -->
                                                                        <Button Grid.Row="2"
                                                                                Grid.Column="2"
                                                                                Content="↘"
                                                                                Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                                                PreviewMouseDown="PanRightTiltDown_MouseDown"
                                                                                PreviewMouseUp="MoveStop_MouseUp"
                                                                                MouseLeave="MoveStop_MouseLeave"/>

                                                                    </Grid>

                                                                    <!-- 이동 단위 표시 -->
                                                                    <TextBlock Grid.Row="2"
                                                                               Text="{Binding PanTiltSpeedLevel,StringFormat=PT SPEED LV : {0}}"
                                                                               Foreground="#D0D7DE"
                                                                               FontSize="12"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,5,0,0"/>
                                                                </Grid>
                                                            </Border>


                                                            <!-- [PTZF] Position 기반 이동 제어

                                                                기존 AI DETECTOR SETTING 내부에 잘못 배치되었던
                                                                이동 제어 UI를 운용 제어의 PTZF 탭으로 이동한다.

                                                                PAN / TILT CONTROL 아래에 배치하며,
                                                                상위 ScrollViewer를 사용하여 화면 높이가 부족한 경우에도
                                                                전체 항목을 세로 스크롤로 사용할 수 있도록 한다.

                                                                포함 기능:
                                                                1. PAN TURN MODE
                                                                2. PAN / TILT Absolute Move
                                                                3. EO / IR Zoom Position / Ratio
                                                                4. EO / IR Focus Position
                                                                5. 입력값 초기화

                                                                추가 기능:
                                                                1. HOME POSITION
                                                                2. PAN ZERO
                                                            3. TILT ZERO -->
                                                            <!-- [Pan] 선회 모드 영역 -->
                                                            <Border Background="#5C666D"
                                                                    BorderBrush="#95A5B0"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5"
                                                                    Padding="12"
                                                                    Margin="0,0,0,7">

                                                                <StackPanel>

                                                                    <TextBlock Text="PAN TURN MODE"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="White"
                                                                               FontSize="12"
                                                                               FontWeight="Bold"
                                                                               Margin="0,0,0,10"/>

                                                                    <StackPanel Orientation="Horizontal"
                                                                                HorizontalAlignment="Center">

                                                                        <!--
                                                                            [SHORT]
                                                                            현재 Pan 위치에서 목표 Pan 위치까지
                                                                            가장 가까운 방향으로 이동한다.
                                                                        -->
                                                                        <RadioButton Content="SHORT"
                                                                                     GroupName="MoveControlPanTurnMode"
                                                                                     IsChecked="{Binding IsPanTurnShortMode, Mode=TwoWay}"
                                                                                     Foreground="White"
                                                                                     FontSize="12"
                                                                                     FontWeight="Bold"
                                                                                     Margin="0,0,20,0"/>

                                                                        <!--
                                                                            [VIA 0]
                                                                            현재 Pan 위치에서 목표 Pan 위치까지
                                                                            정방향으로 이동하며 0도 경계를 경유한다.
                                                                        -->
                                                                        <RadioButton Content="VIA 0"
                                                                                     GroupName="MoveControlPanTurnMode"
                                                                                     IsChecked="{Binding IsPanTurnViaZeroMode, Mode=TwoWay}"
                                                                                     Foreground="White"
                                                                                     FontSize="12"
                                                                                     FontWeight="Bold"/>

                                                                    </StackPanel>

                                                                </StackPanel>

                                                            </Border>

                                                            <!--
                                                                [Home / Zero] 제어 영역

                                                                MCB/LA AGENT 전용 기능이므로
                                                                ROOFTOP / LA AGENT 상태에서만 표시한다.
                                                                ENVIRONMENT / WEB AGENT 상태에서는 완전히 숨긴다.
                                                            -->
                                                            <Border Background="#5C666D"
                                                                    BorderBrush="#95A5B0"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5"
                                                                    Padding="10"
                                                                    Margin="0,0,0,7">

                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility"
                                                                                Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHomeZeroVisible}"
                                                                                         Value="True">
                                                                                <Setter Property="Visibility"
                                                                                        Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <StackPanel>
                                                                    <TextBlock Text="HOME / ZERO"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="White"
                                                                               FontSize="12"
                                                                               FontWeight="Bold"
                                                                               Margin="0,0,0,8"/>

                                                                    <Button Content="HOME POSITION"
                                                                            Height="30"
                                                                            Margin="0,0,0,7"
                                                                            Command="{Binding MoveHomePositionCommand}"/>

                                                                    <UniformGrid Columns="2">
                                                                        <Button Content="PAN ZERO"
                                                                                Height="28"
                                                                                Margin="2"
                                                                                Command="{Binding SetPanZeroCommand}"/>
                                                                        <Button Content="TILT ZERO"
                                                                                Height="28"
                                                                                Margin="2"
                                                                                Command="{Binding SetTiltZeroCommand}"/>
                                                                    </UniformGrid>

                                                                    <TextBlock Text="{Binding HomeZeroStatusText}"
                                                                               Foreground="#F6E05E"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               TextAlignment="Center"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,7,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <TextBlock Text="PAN : -180° ~ 180°   /   TILT : -90° ~ 90°"
                                                                       Foreground="#F6E05E"
                                                                       FontSize="9.5"
                                                                       FontWeight="Bold"
                                                                       TextAlignment="Center"
                                                                       Margin="0,3,5,6"/>

                                                            <!-- [Absolute] 위치 이동 영역 -->
                                                            <Border Margin="0,0,0,7"
                                                                    Background="#5F666D"
                                                                    BorderBrush="#95A5B0"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="5"
                                                                    Padding="12">

                                                                <StackPanel>

                                                                    <TextBlock Text="ABSOLUTE MOVE"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="White"
                                                                               FontWeight="Bold"
                                                                               Margin="0,0,0,5"/>

                                                                    <TextBlock Text="Pan Target  (-180° ~ 180°)"
                                                                               Foreground="White"
                                                                               FontSize="12"/>

                                                                    <!-- Pan Absolute 입력 범위: -180 ~ 180 / 소수점 둘째 자리 -->
                                                                    <TextBox Text="{Binding PanAbsoluteValue, UpdateSourceTrigger=LostFocus}"
                                                                             PreviewTextInput="PanDecimalNumberOnly_PreviewTextInput"
                                                                             LostFocus="PanAngle_LostFocus"
                                                                             Height="24"
                                                                             Margin="0,3,0,5"
                                                                             FontWeight="Bold"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <Button Content="PAN GO"
                                                                            Height="30"
                                                                            Margin="0,0,0,20"
                                                                            Style="{StaticResource EoControlButtonStyle}"
                                                                            Command="{Binding MovePanAbsoluteCommand}"/>

                                                                    <TextBlock Text="Tilt Target  (-90° ~ 90°)"
                                                                               Foreground="White"
                                                                               FontSize="12"/>

                                                                    <!-- Tilt Absolute 입력 범위: -90 ~ 90 / 소수점 둘째 자리 -->
                                                                    <TextBox Text="{Binding TiltAbsoluteValue, UpdateSourceTrigger=LostFocus}"
                                                                             PreviewTextInput="DecimalNumberOnly_PreviewTextInput"
                                                                             LostFocus="TiltAngle_LostFocus"
                                                                             Height="24"
                                                                             Margin="0,3,0,5"
                                                                             FontWeight="Bold"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <Button Content="TILT GO"
                                                                            Height="30"
                                                                            Margin="0,0,0,8"
                                                                            Style="{StaticResource EoControlButtonStyle}"
                                                                            Command="{Binding MoveTiltAbsoluteCommand}"/>

                                                                    <!--
                                                                        Absolute 위치 이동 전용 정지

                                                                        방향 버튼 중앙 STOP과 달리 위치 이동 정지 명령
                                                                        Command2=0x4F를 Pan / Tilt 축에 각각 송신한다.
                                                                    -->
                                                                    <Button Content="STOP ABSOLUTE MOVE"
                                                                            Height="30"
                                                                            Style="{StaticResource StopButtonStyle}"
                                                                            Command="{Binding StopAbsoluteMoveCommand}"/>

                                                                </StackPanel>

                                                            </Border>

                                                            <!-- [Zoom] 위치 / 배율 제어 영역 -->
                                                            <Border Margin="0,0,0,7"
                                                                    Background="#5F666D"
                                                                    BorderBrush="#95A5B0"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="5"
                                                                    Padding="12">

                                                                <StackPanel>

                                                                    <TextBlock Text="ZOOM MOVE"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="White"
                                                                               FontWeight="Bold"
                                                                               Margin="0,0,0,5"/>

                                                                    <TextBlock Text="EO / IR 50x STANDARD"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="#8FD3FF"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Margin="0,0,0,7"/>

                                                                    <TextBlock Text="Zoom Position (0 ~ 1000)"
                                                                               Foreground="White"
                                                                               FontSize="12"/>

                                                                    <!-- EO / IR 공통 표준 Position 범위: 0 ~ 1000 -->
                                                                    <TextBox Text="{Binding ZoomPositionValue, UpdateSourceTrigger=LostFocus}"
                                                                             PreviewTextInput="IntegerNumberOnly_PreviewTextInput"
                                                                             LostFocus="PositionValue_LostFocus"
                                                                             Height="24"
                                                                             Margin="0,3,0,5"
                                                                             FontWeight="Bold"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <Button Content="SET ZOOM"
                                                                            Height="30"
                                                                            Margin="0,0,0,20"
                                                                            Style="{StaticResource EoControlButtonStyle}"
                                                                            Command="{Binding SetZoomPositionCommand}"/>

                                                                    <TextBlock Text="EO Zoom Ratio"
                                                                               Foreground="White"
                                                                               FontSize="12"/>

                                                                    <TextBlock Text="EO 1.0~50.0x / IR은 동일 진행률로 1.0~5.0x 적용"
                                                                               Foreground="#8FD3FF"
                                                                               FontSize="9.5"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,2,0,2"/>

                                                                    <!-- EO 배율 입력 범위: 1.0 ~ 50.0
                                                                        입력한 EO 배율을 0 ~ 1000 진행률로 변환한 뒤
                                                                    IR에도 동일 Position 비율을 적용한다. -->
                                                                    <TextBox Text="{Binding ZoomRatioValue, UpdateSourceTrigger=LostFocus}"
                                                                             PreviewTextInput="ZoomRatio_PreviewTextInput"
                                                                             LostFocus="ZoomRatio_LostFocus"
                                                                             Height="24"
                                                                             Margin="0,3,0,5"
                                                                             FontWeight="Bold"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <Button Content="SET EO RATIO / IR PROPORTIONAL"
                                                                            Height="30"
                                                                            Style="{StaticResource EoControlButtonStyle}"
                                                                            Command="{Binding SetZoomRatioCommand}"/>

                                                                </StackPanel>

                                                            </Border>

                                                            <!-- [Focus] 위치 제어 영역 -->
                                                            <Border Margin="0,0,0,7"
                                                                    Background="#5F666D"
                                                                    BorderBrush="#95A5B0"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="5"
                                                                    Padding="12">

                                                                <StackPanel>

                                                                    <TextBlock Text="FOCUS MOVE"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="White"
                                                                               FontWeight="Bold"
                                                                               Margin="0,0,0,5"/>

                                                                    <TextBlock Text="0 = FAR  /  1000 = NEAR"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="#8FD3FF"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Margin="0,0,0,7"/>

                                                                    <TextBlock Text="Focus Position (0 ~ 1000)"
                                                                               Foreground="White"
                                                                               FontSize="12"/>

                                                                    <!-- EO 표준값은 그대로 적용하고 IR Raw 값은 내부에서 역변환한다. -->
                                                                    <TextBox Text="{Binding FocusPositionValue, UpdateSourceTrigger=LostFocus}"
                                                                             PreviewTextInput="IntegerNumberOnly_PreviewTextInput"
                                                                             LostFocus="PositionValue_LostFocus"
                                                                             Height="24"
                                                                             Margin="0,3,0,5"
                                                                             FontWeight="Bold"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <Button Content="SET FOCUS"
                                                                            Height="30"
                                                                            Style="{StaticResource EoControlButtonStyle}"
                                                                            Command="{Binding SetFocusPositionCommand}"/>

                                                                </StackPanel>

                                                            </Border>

                                                            <!-- [입력값 초기화] 영역 -->
                                                            <Border Margin="0,3,0,5"
                                                                    Background="#6A7178"
                                                                    BorderBrush="#95A5B0"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5"
                                                                    Padding="12">

                                                                <StackPanel>

                                                                    <TextBlock Text="INPUT CONTROL"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="White"
                                                                               FontWeight="Bold"
                                                                               Margin="0,0,0,7"/>

                                                                    <Button Content="RESET INPUT"
                                                                            Height="30"
                                                                            Style="{StaticResource EoControlButtonStyle}"
                                                                            Command="{Binding ResetPositionInputCommand}"/>

                                                                </StackPanel>

                                                            </Border>


                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </TabItem>

                                                <!-- [PRESET] 프리셋 등록 / 이동 / 오토 스캔 제어 -->
                                                <TabItem x:Name="PresetLTab"
                                                         Header="PRESET L&#x0a;(LA TEST)">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <StackPanel Margin="4,2,2,5">

                                                            <!-- 프리셋 추가 / 갱신 / 제거 -->
                                                            <Border Margin="0,5,5,0"
                                                                    Background="#5F666D"
                                                                    BorderBrush="#95A5B0"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="5"
                                                                    Padding="7">

                                                                <StackPanel>

                                                                    <TextBlock Text="PRESET L / LA AGENT Ver."
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="White"
                                                                               FontWeight="Bold"
                                                                               Margin="0,0,0,10"/>

                                                                    <TextBlock Text="LA Scan Point ID  (0 ~ 99)"
                                                                               Foreground="White"
                                                                               FontSize="11"/>

                                                                    <ComboBox ItemsSource="{Binding LaPresetSlotOptions}"
                                                                              IsEnabled="{Binding IsOperationCommandEnabled}"
                                                                              SelectedItem="{Binding LaPresetSlotNumber, Mode=TwoWay}"
                                                                              Height="27"
                                                                              Margin="0,3,0,8"
                                                                              FontWeight="Bold"
                                                                              VerticalContentAlignment="Center"/>

                                                                    <!-- ADD 명령은 현재 장비의 PTZF 상태를 LA 슬롯에 저장한다. -->
                                                                    <Border Background="#4A5056"
                                                                            BorderBrush="#7E8A94"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4"
                                                                            Padding="7"
                                                                            Margin="0,0,0,8">

                                                                        <StackPanel>

                                                                            <TextBlock Text="CURRENT PTZF SNAPSHOT"
                                                                                       Foreground="#8FD3FF"
                                                                                       FontSize="10"
                                                                                       FontWeight="Bold"
                                                                                       HorizontalAlignment="Center"
                                                                                       Margin="0,0,0,7"/>

                                                                            <TextBlock Text="{Binding CurrentLaPresetSnapshotText}"
                                                                                       Foreground="#F1F4F6"
                                                                                       FontFamily="Consolas"
                                                                                       FontSize="10"
                                                                                       TextWrapping="Wrap"/>

                                                                        </StackPanel>

                                                                    </Border>

                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition/>
                                                                            <ColumnDefinition/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <Button Grid.Column="0"
                                                                                IsEnabled="{Binding IsOperationCommandEnabled}"
                                                                                Content="REGISTER / UPDATE"
                                                                                Height="30"
                                                                                Margin="0,0,4,0"
                                                                                Style="{StaticResource EoControlButtonStyle}"
                                                                                Command="{Binding AddOrUpdateLaPresetCommand}"/>

                                                                        <Button Grid.Column="1"
                                                                                IsEnabled="{Binding IsOperationCommandEnabled}"
                                                                                Content="DELETE"
                                                                                Height="30"
                                                                                Margin="4,0,0,0"
                                                                                Background="#8A3D3D"
                                                                                Foreground="White"
                                                                                FontWeight="Bold"
                                                                                BorderBrush="#C87070"
                                                                                BorderThickness="1"
                                                                                Command="{Binding ClearAllLaPresetsCommand}"/>

                                                                    </Grid>

                                                                    <TextBlock Text="※ ADD는 현재 PTZF 위치를 선택 슬롯에 저장합니다."
                                                                               Foreground="#D0D7DE"
                                                                               FontSize="9.5"
                                                                               TextWrapping="Wrap"
                                                                               TextAlignment="Center"
                                                                               Margin="0,7,0,0"/>

                                                                </StackPanel>

                                                            </Border>

                                                            <!-- 현재 프로그램에서 등록한 프리셋 목록 -->
                                                            <Border Margin="0,10,5,0"
                                                                    Background="#5F666D"
                                                                    BorderBrush="#95A5B0"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="5"
                                                                    Padding="7">

                                                                <StackPanel>

                                                                    <TextBlock Text="REGISTERED PRESETS"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="White"
                                                                               FontWeight="Bold"
                                                                               Margin="0,0,0,10"/>

                                                                    <ComboBox ItemsSource="{Binding LaPresetPoints}"
                                                                              IsEnabled="{Binding IsOperationCommandEnabled}"
                                                                              SelectedItem="{Binding SelectedLaPresetPoint, Mode=TwoWay}"
                                                                              DisplayMemberPath="DisplayText"
                                                                              Height="29"
                                                                              Margin="0,0,0,8"
                                                                              HorizontalContentAlignment="Stretch"/>

                                                                    <Border Background="#4A5056"
                                                                            BorderBrush="#7E8A94"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4"
                                                                            Padding="7"
                                                                            Margin="0,0,0,7">

                                                                        <TextBlock Text="{Binding SelectedLaPresetDetailText}"
                                                                                   Foreground="#F1F4F6"
                                                                                   FontFamily="Consolas"
                                                                                   FontSize="10"
                                                                                   TextWrapping="Wrap"/>

                                                                    </Border>

