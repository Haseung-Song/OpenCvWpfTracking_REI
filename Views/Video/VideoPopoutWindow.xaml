<Window x:Class="OpenCvWpfTracking.VideoPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VIDEO VIEW"
        Width="1280"
        Height="720"
        MinWidth="800"
        MinHeight="450"
        Background="Black"
        WindowStartupLocation="CenterOwner"
        Focusable="True"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Grid Background="Black"
          ClipToBounds="True">

        <!--
            MainViewModel의 기존 BitmapSource를 그대로 Binding한다.

            별도 RTSP Decoder나 Capture Loop를 생성하지 않으므로
            메인 화면과 분리 창이 동일 프레임을 공유한다.
        -->
        <!--
            2026-08-25: 분리 창은 원본 BitmapSource를 Uniform으로 공유한다.
            창은 실제 프레임 종횡비로 자동 조정되어 왜곡과 가장자리 잘림을 방지한다.
        -->
        <Rectangle x:Name="CameraImage"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True"/>

        <!--
            2026-08-25: 메인창과 동일한 원본 영상 좌표계로 EO/IR AI BBox를 표시한다.
            카메라 전환 시 code-behind에서 ItemsSource와 원본 해상도 Binding을 함께 교체한다.
        -->
        <Viewbox Stretch="Uniform"
                 IsHitTestVisible="False"
                 Panel.ZIndex="10">
            <ItemsControl x:Name="PopoutDetectionItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Width="{Binding Width,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Height="{Binding Height,
                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                ClipToBounds="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- 2026-08-26: 메인 화면과 동일한 형광 라임 AI BBox/순번을 표시한다. -->
                            <Rectangle Width="{Binding Width}"
                                       Height="{Binding Height}"
                                       Stroke="#FF39FF14"
                                       StrokeThickness="4"/>
                            <Border Background="#DD102A10"
                                    BorderBrush="#FF39FF14"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding DisplayText}"
                                           Foreground="#FF39FF14"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Padding="5,1"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Viewbox>

        <!-- 중앙 십자선 -->
        <Grid Width="72"
              Height="72"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsHitTestVisible="False">

            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCrosshairVisible}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- 검정 외곽선 -->
            <Canvas Width="72"
                    Height="72">

                <Line X1="36"
                      Y1="2"
                      X2="36"
                      Y2="70"
                      Stroke="#CC000000"
                      StrokeThickness="4"/>

                <Line X1="2"
                      Y1="36"
                      X2="70"
                      Y2="36"
                      Stroke="#CC000000"
                      StrokeThickness="4"/>

            </Canvas>

            <!-- 메인 화면과 동일한 사용자 선택 색상의 십자선 본선 -->
            <Canvas Width="72"
                    Height="72">

                <Line X1="36"
                      Y1="2"
                      X2="36"
                      Y2="70"
                      Stroke="{Binding CrosshairBrush}"
                      StrokeThickness="2"/>

                <Line X1="2"
                      Y1="36"
                      X2="70"
                      Y2="36"
                      Stroke="{Binding CrosshairBrush}"
                      StrokeThickness="2"/>

            </Canvas>

        </Grid>

        <!-- 카메라 및 단축키 안내 -->
        <Grid Margin="14"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">

        <Border x:Name="CameraInfoBorder"
                Visibility="Collapsed"
                Padding="42,7,10,7"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#B21D232A"
                BorderBrush="#5EE7F7"
                BorderThickness="1"
                CornerRadius="3">

            <StackPanel>

                <TextBlock x:Name="CameraTitleText"
                           Foreground="#5EE7F7"
                           FontSize="18"
                           FontWeight="Bold"/>

                <!-- EO / IR 주화면 선택 단축키 -->
                <TextBlock Margin="0,4,0,0"
                           Text="R : EO MAIN    T : IR MAIN"
                           Foreground="#FFD166"
                           FontSize="13"
                           FontWeight="Bold"/>

                <!-- 메인 화면과 동일한 Pan / Tilt 방향키 -->
                <TextBlock Margin="0,4,0,0"
                           Text="ARROW KEYS : PAN / TILT CONTROL"
                           Foreground="#9FE870"
                           FontSize="13"
                           FontWeight="Bold"/>

                <!-- 현재 선택된 영상의 렌즈 제어 단축키 -->
                <TextBlock Margin="0,4,0,0"
                           Text="W : ZOOM IN    S : ZOOM OUT    A : FOCUS NEAR    D : FOCUS FAR"
                           Foreground="White"
                           FontSize="13"/>

                <TextBlock Margin="0,2,0,0"
                           Text="키를 떼면 동작이 정지합니다."
                           Foreground="#D0D0D0"
                           FontSize="12"/>

                <!-- AUTO SCAN 중 분리 창 단축키 잠금 안내 -->
                <TextBlock Margin="0,7,0,0"
                           Text="AUTO SCAN 동작 중이므로 키 입력이 비활성화됩니다."
                           Foreground="#FFFF6B6B"
                           FontSize="13"
                           FontWeight="Bold">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPresetScanControlLocked}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>

                <!--
                    HOME POSITION 중 분리 창 단축키 잠금 안내

                    IsHomePositionMoving은 HOME POSITION뿐만 아니라
                    PAN ZERO / TILT ZERO 작업에도 공통으로 사용된다.

                    HOME POSITION 실행 중에만 안내 문구가 표시되도록
                    HomeZeroLockTitle을 함께 확인한다.
                -->
                <TextBlock Margin="0,7,0,0"
                           Text="HOME POSITION 동작 중이므로 키 입력이 비활성화됩니다."
                           Foreground="#FFFF6B6B"
                           FontSize="13"
                           FontWeight="Bold">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>
                                <MultiDataTrigger>

                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsHomePositionMoving}"
                                                   Value="True"/>

                                        <Condition Binding="{Binding HomeZeroLockTitle}"
                                                   Value="HOME POSITION"/>
                                    </MultiDataTrigger.Conditions>

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </MultiDataTrigger>
                            </Style.Triggers>

                        </Style>
                    </TextBlock.Style>

                </TextBlock>

                <!-- 2026-08-18: 파노라마 촬영·정합·블렌딩·저장 중 EO/IR 분리 창 키 입력 잠금 안내 -->
                <TextBlock Margin="0,7,0,0"
                           Text="360° PANORAMA 작업 중이므로 키 입력이 비활성화됩니다."
                           Foreground="#FFFF6B6B"
                           FontSize="13"
                           FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPanoramaProcessingRunning}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>

        </Border>

        <!-- 2026-08-25: 단축키 안내 패널 왼쪽 상단 접기/펼치기 -->
        <Button x:Name="CameraInfoToggleButton"
                Width="28"
                Height="28"
                Margin="4,4,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="20"
                Content="▼"
                FontSize="15"
                FontWeight="Bold"
                Foreground="White"
                Background="#B21D232A"
                BorderBrush="#5EE7F7"
                BorderThickness="1"
                ToolTip="단축키 안내 표시하기"
                Click="CameraInfoToggleButton_Click"/>

        </Grid>

        <!-- 현재 카메라 연결 및 영상 상태 -->
        <TextBlock x:Name="CameraStatusText"
                   Margin="0,0,14,10"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   FontSize="16"
                   FontWeight="Bold"
                   IsHitTestVisible="False"/>

    </Grid>

</Window>
