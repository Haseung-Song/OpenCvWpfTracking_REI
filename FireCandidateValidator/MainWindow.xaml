<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FireCandidateValidator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IR FIRE DETECTOR TEST PROGRAM"
        Width="1500" Height="900" MinWidth="1100" MinHeight="700"
        Background="#20262D" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- 2026-08-14: Explicit keys avoid ResourceDictionary designer errors. -->
        <Style x:Key="ValidatorButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#34566A"/>
            <Setter Property="BorderBrush" Value="#7FB3E6"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ValidatorTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#E8EEF4"/>
        </Style>
        <Style x:Key="ValidatorSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Margin" Value="4,2"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="10" Background="#343D46" BorderBrush="#7F96A8" BorderThickness="1" CornerRadius="5">
            <DockPanel>
                <TextBlock Margin="6,0,18,0" VerticalAlignment="Center" Text="IR FIRE DETECTOR TEST PROGRAM" Foreground="#FF5252" FontSize="18" FontWeight="Bold"/>
                <Button Style="{StaticResource ValidatorButtonStyle}" Content="OPEN IMAGE" Click="OpenImage_Click"/>
                <Button Style="{StaticResource ValidatorButtonStyle}" Content="OPEN VIDEO" Click="OpenVideo_Click"/>
                <Button Style="{StaticResource ValidatorButtonStyle}" Content="IR TEST PATTERN" Click="CreateTestPattern_Click"/>
                <Button Style="{StaticResource ValidatorButtonStyle}" Content="RESET" Background="#7A3434" Click="Reset_Click"/>
                <Button Style="{StaticResource ValidatorButtonStyle}" Content="SAVE IMAGE" Click="SaveResult_Click"/>
                <Button Style="{StaticResource ValidatorButtonStyle}" x:Name="SaveVideoButton" Content="START VIDEO SAVE" Click="SaveVideo_Click"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="6" Background="Black" BorderBrush="#7FB3E6" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Image x:Name="ResultImage" Stretch="Uniform"/>
                    <TextBlock Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Text="IR PALETTE / FIRE DETECTOR OVERLAY" Foreground="#FF5252" FontWeight="Bold"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Padding="6" Background="Black" BorderBrush="#FFD166" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Image x:Name="MaskImage" Stretch="Uniform"/>
                    <TextBlock Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Text="PALETTE-INDEPENDENT FIRE DETECTOR MASK" Foreground="#FF5252" FontWeight="Bold"/>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Padding="12" Background="#343D46" BorderBrush="#7F96A8" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <!-- 2026-08-14: Runtime-selectable fire BBox grouping. -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="FIRE DETECTION 구분 방식" FontWeight="Bold" Foreground="#FF8A80"/>
                    <UniformGrid Columns="2" Margin="0,4,0,8">
                        <Button x:Name="FireBoxMode1Button" Content="구분 방식 1 (전체 단일 박스)" Background="#3E515E" Padding="4,2" Click="FireBoxMode1_Click"/>
                        <Button x:Name="FireBoxMode2Button" Content="구분 방식 2 (화염별 분리)" Background="#2A6F97" Padding="4,2" Click="FireBoxMode2_Click"/>
                    </UniformGrid>
                </StackPanel>
                <StackPanel Grid.Column="0">
                    <StackPanel.Margin>0,50,0,0</StackPanel.Margin>
                    <TextBlock Text="HOT PIXEL THRESHOLD" FontWeight="Bold"/>
                    <!-- 2026-08-14: Same offline validation defaults as the main viewer. -->
                    <Slider x:Name="ThresholdSlider" Minimum="0.05" Maximum="0.99" Value="0.72" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="Setting_ValueChanged"/>
                    <TextBlock x:Name="ThresholdText" HorizontalAlignment="Right" Text="0.72"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel.Margin>0,50,0,0</StackPanel.Margin>
                    <TextBlock Text="MINIMUM FIRE DETECTOR AREA RATIO" FontWeight="Bold"/>
                    <Slider x:Name="AreaSlider" Minimum="0.0005" Maximum="0.05" Value="0.0015" TickFrequency="0.0005" IsSnapToTickEnabled="True" ValueChanged="Setting_ValueChanged"/>
                    <TextBlock x:Name="AreaText" HorizontalAlignment="Right" Text="0.0015"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="IR DISPLAY PALETTE" FontWeight="Bold"/>
                    <!-- 2026-08-14: Device-independent direct and relative palette buttons. -->
                    <UniformGrid Columns="3" Margin="0,4,0,2">
                        <Button x:Name="BlackHotPaletteButton" Content="BLACK HOT" Background="#F4F4F4" Foreground="#20262D" Padding="2,1" Click="BlackHotPalette_Click"/>
                        <Button x:Name="WhiteHotPaletteButton" Content="WHITE HOT" Background="#F4F4F4" Foreground="#20262D" Padding="2,1" Click="WhiteHotPalette_Click"/>
                        <Button x:Name="RandomPaletteButton" Content="RANDOM" Background="#F4F4F4" Foreground="#20262D" Padding="2,1" Click="RandomPalette_Click"/>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button Content="PREV" Background="#3E515E" Padding="2,1" Click="PreviousPalette_Click"/>
                        <Button Content="NEXT" Background="#3E515E" Padding="2,1" Click="NextPalette_Click"/>
                    </UniformGrid>
                    <TextBlock Text="VIDEO CONFIRM FRAMES" FontWeight="Bold"/>
                    <Slider x:Name="ConfirmationSlider" Minimum="1" Maximum="15" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Setting_ValueChanged"/>
                    <TextBlock x:Name="ConfirmationText" HorizontalAlignment="Right" Text="6 frames"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.ColumnSpan="5" Margin="0,178,0,0" HorizontalAlignment="Center" Text="Open an image or IR video." Foreground="#9FE870" FontSize="14" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
